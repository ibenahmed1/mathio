    {
      "name": "2 — Déclarer un lot",
      "description": "Ce qu'un livreur envoie en rentrant de tournée. Cent lignes maximum.",
      "item": [
        {
          "name": "2.1 Lot mixte → 200, une ligne refusée sur trois",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 meme avec une ligne fautive', () => pm.response.to.have.status(200));",
                  "const corps = pm.response.json();",
                  "pm.test('2 lignes traitees', () => pm.expect(corps.totalTraite).to.eql(2));",
                  "pm.test('1 ligne refusee', () => pm.expect(corps.totalRefuse).to.eql(1));",
                  "pm.test('3 resultats, un par ligne envoyee', () =>",
                  "  pm.expect(corps.resultats).to.have.lengthOf(3));",
                  "pm.test('la ligne fautive porte son propre code d erreur', () => {",
                  "  const refusee = corps.resultats.find((r) => r.issue === 'refuse');",
                  "  pm.expect(refusee.code).to.eql('colis_introuvable');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
