# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# Chaîne de connexion PostgreSQL. Chargée par prisma.config.ts (dotenv) et par
# lib/prisma.ts via l'adaptateur pg.
DATABASE_URL=postgresql://user:password@host:5432/mathio?sslmode=require

# ---------------------------------------------------------------------------
# Secrets applicatifs (obligatoires en production)
# ---------------------------------------------------------------------------
# Signature des JWT de session (lib/auth.ts). Générer une valeur aléatoire
# forte : openssl rand -base64 48
AUTH_SECRET=

# Clé de chiffrement des numéros de série de colis (lib/parcel-serial.ts).
# 16 caractères minimum, sinon le démarrage échoue en production.
#   openssl rand -base64 32
# ATTENTION : cette clé est DÉFINITIVE. Les codes colis et les QR codes en
# sont dérivés à la volée (rien n'est stocké en base) : la changer après la
# mise en service invalide tous les codes déjà imprimés.
PARCEL_SERIAL_SALT_KEY=

# ---------------------------------------------------------------------------
# Compte administrateur d'amorçage (prisma/seed.ts)
# ---------------------------------------------------------------------------
# Identifiants du tout premier compte, créé par `npm run db:seed` quand la base
# est vide. Sans surcharge ici, le seed retombe sur admin@mathio.com /
# Admin1234! — valeurs en clair dans le dépôt, à ne pas laisser en production.
# Le mot de passe doit respecter la politique de l'app (8 caractères minimum,
# une majuscule, un chiffre, un caractère spécial), sinon le seed refuse de
# s'exécuter. Le seed ne réapplique jamais ces valeurs sur un compte déjà
# existant : une fois le mot de passe changé depuis l'app, il le reste.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOM=

# ---------------------------------------------------------------------------
# URL publique
# ---------------------------------------------------------------------------
# Utilisée uniquement par scripts/test-tournee-cloture-audit.ts. L'application
# ne la lit pas : le lien de réinitialisation de mot de passe est construit
# depuis l'origine de la requête (app/api/auth/mot-de-passe-oublie/route.ts),
# donc c'est la configuration du reverse proxy (X-Forwarded-Host / -Proto) qui
# détermine l'URL envoyée par email. Sans slash final.
BASE_URL=https://exemple.com

# ---------------------------------------------------------------------------
# SMTP (optionnel)
# ---------------------------------------------------------------------------
# Deux usages : l'email de réinitialisation de mot de passe, et l'invitation
# d'un membre à un pôle du Kanban (/admin/tasks — lien d'activation valable
# 7 jours vers NEXT_PUBLIC_HOST_ADMIN).
# Tant que ces variables ne sont pas remplies, aucun email n'est envoyé (log
# console uniquement) : la réinitialisation manuelle par un admin depuis
# /admin/utilisateurs reste disponible, et l'invitation retombe sur un lien
# d'activation affiché à l'écran, à transmettre à la main.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Séparation des espaces par domaine (obligatoire en production)
# ---------------------------------------------------------------------------
# Un espace applicatif = un hôte = un cookie de session (cf. lib/auth.ts).
# Le proxy déduit l'espace du `Host` de la requête : un hôte absent de cette
# liste reçoit un 404, sans même lire les cookies.
#
# TROIS espaces sur TROIS domaines RACINES totalement distincts — pas un
# domaine unique découpé en sous-domaines. Chaque paire est alors *cross-site*
# pour le navigateur, ce qui fait de SameSite une barrière CSRF effective entre
# TOUS les espaces, retire tout support au "cookie tossing" (aucun parent
# commun où poser un cookie qui remonterait chez le voisin), et évite qu'un
# domaine public laisse deviner celui du back-office :
#
#   - domaine "ops"      : back-office, pour TOUT le personnel interne
#                          (jusqu'au planificateur de hub), à filtrer par
#                          IP/VPN ;
#   - domaine "marchand" : les boutiques clientes ;
#   - domaine "terrain"  : livreurs et ramasseurs.
#
# Prendre trois NOMS ENREGISTRÉS SÉPARÉMENT (les exemples ci-dessous n'ont
# volontairement aucune racine commune) et prévoir un certificat par domaine.
# Renseigner l'hôte SEUL (pas de schéma, pas de slash final) ; inclure le port
# uniquement s'il est non standard. Ces valeurs sont figées à la compilation
# (préfixe NEXT_PUBLIC_) : changer un domaine impose de rebuilder.
#
# Sans surcharge, l'app retombe sur admin.localhost:3000 /
# marchand.localhost:3000 / app.localhost:3000 en développement, et REFUSE de
# démarrer en production. Ces trois-là SONT frères sous `.localhost` : c'est la
# seule entorse au modèle, tolérée parce qu'en local l'isolation repose sur le
# contrôle d'Origin du proxy (cf. lib/spaces.ts, SPACE_HOSTS_DEV).
NEXT_PUBLIC_HOST_ADMIN=ops-exemple.com
NEXT_PUBLIC_HOST_MARCHAND=exemple-marchands.ma
NEXT_PUBLIC_HOST_TERRAIN=exemple-livraison.ma

# En développement, ces mêmes variables servent à tester depuis un vrai
# téléphone : un tunnel HTTPS (`npx ngrok http 3000`) expose une URL publique,
# mais le proxy la refuse en 404 tant qu'elle n'est l'hôte d'aucun espace.
# Affecter le domaine du tunnel à l'espace à tester (un tunnel gratuit ne
# couvre qu'un seul domaine, donc un seul espace à la fois) puis relancer
# `npm run dev`. spaceOrigin() bascule alors automatiquement en `https` pour
# cet hôte, sans quoi le contrôle d'Origin rejetterait le login.
#   NEXT_PUBLIC_HOST_TERRAIN=xxxx.ngrok-free.dev

# ---------------------------------------------------------------------------
# API machine des plateformes partenaires (optionnel)
# ---------------------------------------------------------------------------
# Hôte — un CINQUIÈME hôte, et surtout PAS un quatrième espace : aucun cookie
# n'y est jamais posé, aucune page n'y est servie, et seul le préfixe
# /api/v1/** y répond. Réciproquement, /api/v1/** reçoit 404 sur les trois
# hôtes d'espace ci-dessus.
#
# C'est ce cloisonnement qui rend l'absence de contrôle d'Origin correcte PAR
# CONSTRUCTION sur cet hôte : sans authentification ambiante (pas de cookie),
# il n'y a pas de CSRF à empêcher. Un `Authorization: Bearer` n'est jamais
# joint automatiquement par un navigateur.
#
# NON préfixé NEXT_PUBLIC_, contrairement aux trois hôtes d'espace : aucun
# composant client n'en a besoin, et le garder hors du bundle évite de publier
# l'adresse de l'API machine dans le JavaScript servi aux marchands.
#
# Variable OPTIONNELLE, y compris en production : non renseignée, aucun hôte
# d'API n'est reconnu et toute la surface /api/v1/** reste injoignable. Une
# intégration partenaire s'ouvre donc en posant cette variable, pas en
# déployant du code. Sans surcharge, l'app retombe sur api.localhost:3000 en
# développement uniquement.
#
# Contrairement aux hôtes d'espace, celui-ci PEUT partager sa racine avec un
# domaine métier (api.exemple-marchands.ma) : ne posant aucun cookie, il n'a
# rien à isoler au sens *same-site*. Il doit seulement être distinct des trois
# hôtes d'espace, faute de quoi le démarrage échoue.
HOST_API=api.exemple-marchands.ma
#
# EN DÉVELOPPEMENT LOCAL, préférer :
#   HOST_API=127.0.0.1:3000
# Windows ne résout PAS les sous-domaines `.localhost` : Postman, curl et tout
# client non-navigateur échouent en ENOTFOUND sur `api.localhost`. Un
# navigateur, lui, les résout tout seul — d'où le back-office qui fonctionne
# sans rien configurer. `api.localhost:3000` reste accepté en plus de la
# surcharge, donc les scripts existants continuent de marcher.

# ---------------------------------------------------------------------------
# Power Delivery — remise et suivi des colis par LEUR API (optionnel)
# ---------------------------------------------------------------------------
# Ici c'est NOUS qui appelons leur API (elog.ma), en client : voir
# INTEGRATION_POWER_DELIVERY.md. Sans token, la remise et le suivi échouent
# avec un message explicite ; rien d'autre n'est affecté.
#
# Token généré depuis leur tableau de bord. Envoyé BRUT dans `Authorization`,
# sans « Bearer ». Jamais journalisé.
POWERDELIVERY_TOKEN=
#
# Secret HMAC de LEURS webhooks, le même que celui déclaré chez eux par
# `npx tsx scripts/configurer-webhook-power-delivery.ts --configurer <url>`.
# OBLIGATOIRE pour recevoir quoi que ce soit : sans lui, notre récepteur
# (POST /api/v1/webhooks/power-delivery, sur HOST_API) refuse TOUT webhook.
# 32 caractères au moins : openssl rand -hex 32
POWERDELIVERY_WEBHOOK_SECRET=
#
# TESTS SEULEMENT — pointe le client vers un faux serveur local. À laisser vide
# partout ailleurs : chaque vrai `addparcelsnew` déclenche un ramassage.
# POWERDELIVERY_BASE_URL=http://127.0.0.1:4010

# ---------------------------------------------------------------------------
# EST Livraison — remise des colis par LEUR API (optionnel)
# ---------------------------------------------------------------------------
# Ici c'est NOUS qui appelons leur API (pb.estlivraison.com), en client : voir
# INTEGRATION_EST_LIVRAISON.md. Sans clé, la remise échoue avec un message
# explicite ; rien d'autre n'est affecté.
#
# Clé émise par EST Livraison, remise hors bande — leur API n'a aucun endpoint
# pour l'obtenir. Envoyée BRUTE dans l'en-tête `Client-Key`. Jamais journalisée.
#
# ⚠️ Elle vaut pleins pouvoirs sur notre compte chez eux : qui la détient peut
# créer des colis COD en notre nom ET supprimer ceux qui ne sont pas encore
# ramassés. Leur API ne connaît aucune notion de portée.
EST_LIVRAISON_CLE=
#
# TESTS SEULEMENT — pointe le client vers un faux serveur local. À laisser vide
# partout ailleurs : chaque vrai `add-rammasage` déclenche un ramassage.
# EST_LIVRAISON_BASE_URL=http://127.0.0.1:4011

# --- Intégration Shopify (§ INTEGRATION_SHOPIFY.md) --------------------------
# Clé de chiffrement (AES-256-GCM) des jetons d'accès et clés secrètes des
# boutiques Shopify connectées par les marchands : 32 octets en base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sans elle, aucune boutique ne peut être connectée. La CHANGER rend illisibles
# les secrets déjà stockés : chaque marchand devra reconnecter sa boutique.
CLE_CHIFFREMENT_INTEGRATIONS=
# URL PUBLIQUE en HTTPS, sans chemin, que Shopify appellera pour livrer les
# commandes (le chemin /api/v1/webhooks/shopify est ajouté par le code). Son
# hôte doit être celui de HOST_API : le proxy ne sert /api/v1/** que là. En
# local, c'est un tunnel (ngrok http 3000) — et HOST_API doit alors valoir
# l'hôte du tunnel. Vide : les boutiques se connectent, les produits sont
# importés, mais aucune commande n'arrive (l'écran marchand le dit).
SHOPIFY_WEBHOOK_BASE_URL=

# --- Intégration YouCan (§ INTEGRATION_YOUCAN.md) ---------------------------
# Chaque marchand saisit le Client ID / Client Secret de SA propre application
# YouCan dans l'écran Intégrations (comme Shopify) : aucun identifiant YouCan
# dans l'environnement.
#
# URL de retour OAuth que l'écran affiche au marchand, à déclarer À L'IDENTIQUE
# dans son application YouCan. Vide : https://<hôte marchand servi>/api/integrations/youcan/callback.
YOUCAN_REDIRECT_URI=
# Même rôle et mêmes contraintes que SHOPIFY_WEBHOOK_BASE_URL (HTTPS public,
# hôte = HOST_API) ; le chemin /api/v1/webhooks/youcan est ajouté par le code.
YOUCAN_WEBHOOK_BASE_URL=
# TESTS SEULEMENT — faux serveur local à la place de https://api.youcan.shop.
# YOUCAN_API_BASE_URL=http://127.0.0.1:4012

# --- Notifications push (§ NOTIFICATIONS.md) ---------------------------------
# Firebase Cloud Messaging. Tout vide : aucune alerte push, aucun bouton
# « Activer » — la cloche dans l'application fonctionne quand même.
#
# Compte de service (console Firebase → Paramètres du projet → Comptes de
# service → Générer une nouvelle clé privée) : SECRETS, jamais dans le dépôt.
# La clé privée peut garder ses `\n` littéraux, ils sont convertis au chargement.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Configuration de l'application web (Paramètres du projet → Général → Vos
# applications) et clé VAPID (Cloud Messaging → Certificats Web push). Valeurs
# PUBLIQUES, servies au navigateur à l'exécution par /api/notifications/push-config
# — volontairement pas en NEXT_PUBLIC_*, qui seraient figées au build.
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
