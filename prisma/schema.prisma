datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

// ============================================================
// Enums
// ============================================================

// RF : jeu de rôles back-office aligné sur la maquette "Ajouter Utilisateur"
// (dropdown Fonction). Remplace l'ancien jeu (finance/sav/agent_confirmation,
// cf. migration 20260804_refonte_roles_equipe pour le mapping de migration
// des données existantes) : superviseur a la portée la plus large (tout ce
// que couvraient finance/sav/agent_confirmation combinés), équipe_suivi
// reprend le périmètre d'agent_confirmation (statut colis, commentaires),
// moderateur reprend celui de sav (réclamations, retours), responsable
// reprend celui de finance (paiement). Voir les tableaux ROLES_AUTORISES
// dans app/api/commandes/**/route.ts pour le détail par action.
enum Role {
  admin
  superviseur
  moderateur
  equipe_suivi
  responsable
  marchand
  livreur
  ramasseur
  // Rôles cantonnés à l'outil Kanban (§ /admin/tasks) uniquement — aucun accès
  // au reste du back-office (colis, finances, statistiques, clients). Cf.
  // ROLES_KANBAN_UNIQUEMENT dans lib/auth.ts (confinement appliqué dans
  // proxy.ts) pour le détail du mécanisme.
  design
  gestionnaire_hub
  // Agent de réception au hub régional (§ /admin/scan/reception) : scanne les
  // colis au statut "ramasse" déposés au quai pour les faire passer à
  // "recu_au_hub". Cantonné à cette unique page (ROLES_HUB_UNIQUEMENT,
  // lib/auth.ts + proxy.ts), même mécanisme de confinement que
  // design/gestionnaire_hub ci-dessus. Doit obligatoirement être rattaché à
  // un Hub (Utilisateur.hubId, validé côté API).
  agent_hub
  // Planificateur de tournées du hub (§ /admin/planification,
  // /admin/bon-distribution, /admin/scan/tournee) : compose les Bons de
  // Distribution de SON hub, puis au retour du livreur scanne les colis non
  // livrés et clôture la tournée (reddition de caisse). Contrairement à
  // agent_hub ci-dessus, il n'est PAS cantonné à un sous-chemin du
  // back-office : c'est un rôle interne à part entière (ROLES_BACKOFFICE,
  // lib/auth.ts). Doit obligatoirement être rattaché à un Hub
  // (Utilisateur.hubId, validé côté API) : c'est ce hub — et lui seul — dont
  // il planifie les tournées, et c'est là que se joue son cantonnement, dans
  // les données plutôt que dans le routage.
  planner
  // Compte de SERVICE d'une plateforme partenaire (§ PlateformePartenaire).
  // N'est jamais porté par une personne : il n'existe que pour signer les
  // écritures faites au nom de la plateforme, là où une FK vers Utilisateur
  // est obligatoire (HistoriqueStatutCommande.utilisateurId).
  //
  // C'est le SEUL rôle absent de SPACE_ROLES et de SPACE_LOGIN_ROLES
  // (lib/auth.ts) : il n'appartient à aucun espace applicatif, donc aucun
  // domaine ne peut lui ouvrir de session ni en accepter une. Le refus ne
  // dépend pas de `actif`, ni d'un contrôle dans un handler — il n'y a
  // simplement aucun espace où ce rôle soit autorisé. C'est aussi pourquoi
  // getHomeSpace renvoie `null` pour lui, et pourquoi ROLES_EQUIPE
  // (app/api/utilisateurs) ne le propose pas : il ne se crée pas à la main.
  plateforme
}

enum TypeCompteMarchand {
  marchand
  entreprise
  dropshipping
}

// Nature d'un compte LIVREUR : une personne, ou une société de livraison qui
// travaille avec nous. La distinction est juridique, jamais fonctionnelle —
// une société a exactement les mêmes accès et les mêmes écrans qu'un individu
// (espace terrain, tournées, feuille de route, paie). Elle ne change que deux
// choses : l'identité qui figure sur les documents, et la façon dont l'argent
// lui parvient (une société nous facture, cf. BonPaiement).
//
// Une société de livraison EST, le plus souvent, l'un de nos transporteurs
// sous-traitants : son compte se rattache alors à sa ligne `Prestataire`
// (§ Prestataire.compteLivreurId), et les colis qu'on lui confie par bon
// d'envoi lui sont affectés dès la création du bon. C'est ce rattachement —
// et lui seul — qui lui ouvre une feuille de route ; un transporteur sans
// compte continue de nous renvoyer ses statuts par fichier ou par API, comme
// avant, sans rien voir de nos écrans.
enum TypeCompteLivreur {
  individuel
  societe
}

enum StatutMarchand {
  en_attente_validation
  actif
  suspendu
}

// Cycle de vie d'un colis façon centre d'appel / plateforme de livraison COD
// au Maroc : ces 27 valeurs remplacent l'ancien pipeline logistique linéaire
// (voir migration 20260725_refonte_statuts_colis pour le mapping ancien →
// nouveau). Les libellés affichés vivent dans lib/statuts.ts, pas ici.
enum StatutCommande {
  nouveau_colis
  attente_de_ramassage
  ramasse
  recu
  expedie
  expedier_par_amana
  en_voyage
  mise_en_distribution
  livre
  en_cours
  boite_vocale
  deuxieme_appel_pas_reponse
  troisieme_appel_pas_reponse
  pas_de_reponse_sms
  injoignable
  numero_errone
  client_interesse
  relance_nouveau_client
  attente_de_relancer
  programme
  reporte
  hors_zone
  refuse
  retourne
  en_retour_par_amana
  annule
  annule_par_vendeur
  // § Gestion de stock (/admin/stock/**) : pipeline propre aux colis enStock,
  // qui ne passent pas par le Bon de Livraison marchand classique (cf.
  // commentaire sur Commande.enStock) mais par un Bon de Préparation
  // (BonDePreparation). Ajoutées en fin de liste plutôt qu'insérées au milieu
  // du pipeline call-center ci-dessus pour que l'ajout reste un simple ALTER
  // TYPE ... ADD VALUE (l'ordre d'affichage réel vit dans STATUTS_COMMANDE,
  // lib/statuts.ts, indépendant de l'ordre de déclaration ici).
  pret_pour_preparation
  recu_au_hub
  en_transit
  // § Clôture de tournée (/admin/bon-distribution/[id]/cloture) : état
  // PHYSIQUE du colis revenu au dépôt après une tentative de livraison
  // infructueuse, scanné un par un par le Planner. Distinct de `retourne`
  // (retour définitif au marchand) et de `recu_au_hub` (colis jamais parti en
  // tournée, ou revenu d'un transit inter-hubs) : le motif terrain
  // (refuse/reporte/annule) reste lisible dans l'historique, ce statut ne dit
  // que "il est de nouveau au hub X". Un colis retourne_au_hub n'est pas
  // automatiquement réinjecté dans une nouvelle tournée — il faut une action
  // explicite (relance marchand ou Bon de Retour).
  retourne_au_hub
}

// État du Bon de Préparation lui-même (§ Gestion de stock) : porte la
// distinction "en cours de préparation" / "préparation validée" — c'est ce
// champ, et non un statut Commande dédié, qui représente l'état "préparé"
// (cf. discussion produit du 2026-08-10 : pas de statut Commande "prepare"
// séparé, jugé redondant). Les colis du bon restent au statut
// pret_pour_preparation jusqu'à la validation, qui les fait avancer
// directement vers recu_au_hub ou en_transit (voir lib/hub-stock.ts).
enum StatutBonPreparation {
  en_attente
  validee
}

// État de règlement du COD entre le livreur/l'agence et le marchand —
// indépendant du statut de livraison ci-dessus (un colis "livre" peut rester
// "non_paye" tant que le marchand n'a pas été remboursé). "rembourse" couvre
// l'action admin "Remboursement" (COD restitué au client/marchand).
enum EtatPaiement {
  non_paye
  facture
  paye
  rembourse
}

enum SourceCommande {
  manuel
  import_csv
  api
}

enum StatutRamassage {
  en_attente
  confirmee
  effectuee
  annulee
}

enum ModeCreationRamassage {
  recurrent
  manuel
}

enum TypeListeNoire {
  telephone
  client
  adresse
}

enum MotifListeNoire {
  fraude
  refus_repetitifs
  faux_numero
  client_agressif
  impaye
  autre
}

enum NiveauRisque {
  moyen
  eleve
  critique
}

enum StatutReclamation {
  ouverte
  en_cours
  resolue
  rejetee
}

enum StatutTache {
  a_faire
  en_cours
  termine
}

enum PrioriteTache {
  faible
  moyenne
  elevee
}

// Sens d'une écriture comptable (§ /admin/comptabilite) : revenu = argent
// gagné, depense = argent sorti. Le signe (+/-) et le code couleur (vert/rouge)
// affichés côté UI se dérivent de ce champ, jamais saisis directement — cf.
// lib/finance.ts pour le mapping libellé/couleur.
enum TypeTransaction {
  revenu
  depense
}

// Catégorie d'origine ou de destination de l'argent — liste fermée pour
// garder des totaux comparables d'une écriture à l'autre (cf. lib/finance.ts
// pour les libellés affichés).
enum CategorieTransaction {
  paiement_client
  frais_livraison
  abonnement_outil
  salaire
  remboursement
  autre
}

// ============================================================
// Utilisateurs et marchands
// ============================================================

model Utilisateur {
  id                String    @id @default(uuid())
  nomComplet        String    @map("nom_complet")
  // Nullable : les membres d'équipe marchand invités par email (voir
  // MarchandMembre) n'ont pas forcément de téléphone — ils se connectent
  // avec leur email. Postgres autorise plusieurs NULL sous une contrainte
  // unique, donc ça ne relâche pas l'unicité pour les comptes qui en ont un.
  telephone         String?   @unique
  email             String?   @unique
  motDePasseHash    String    @map("mot_de_passe_hash")
  role              Role
  actif             Boolean   @default(true)
  dateCreation      DateTime  @default(now()) @map("date_creation")
  derniereConnexion DateTime? @map("derniere_connexion")
  resetTokenHash    String?   @unique @map("reset_token_hash")
  resetTokenExpire  DateTime? @map("reset_token_expire")

  // § Comptes livreurs — individu ou société de livraison (cf.
  // TypeCompteLivreur). Nullable pour la même raison que les champs terrain
  // ci-dessous : le champ ne veut rien dire pour un admin ou un ramasseur, et
  // un défaut `individuel` posé sur toute la table ferait passer chaque compte
  // du back-office pour un livreur en puissance. C'est donc l'API
  // (POST/PATCH /api/utilisateurs) qui l'exige quand `role = livreur`, et le
  // force à null partout ailleurs — même dispositif que `hubId`.
  typeLivreur TypeCompteLivreur? @map("type_livreur")

  // Identité légale d'un compte société. FACULTATIVES à ce stade, y compris
  // `raisonSociale` : le module est en cours d'essai et on préfère un compte
  // créé sans ses papiers à un compte qu'on ne peut pas créer. `nomComplet`
  // reste le nom d'usage affiché partout dans l'application ; `raisonSociale`
  // n'existe que pour les documents qui engagent (fiche de paie, plus tard
  // rapprochement de leur facture).
  raisonSociale String? @map("raison_sociale")
  ice           String? @map("ice")

  // Champs propres aux comptes terrain (livreur/ramasseur), saisis lors de la
  // création via le formulaire admin "Ajouter Utilisateur" — nullable pour
  // tous les autres rôles qui ne les utilisent pas.
  cin            String?  @map("cin")
  photoUrl       String?  @map("photo_url")
  zonePrincipale String?  @map("zone_principale")
  zoneSecondaire String?  @map("zone_secondaire")
  adresse        String?  @map("adresse")
  nomBanque      String?  @map("nom_banque")
  numeroCompte   String?  @map("numero_compte")
  fraisLivraison Decimal? @map("frais_livraison") @db.Decimal(10, 2)
  fraisRefus     Decimal? @map("frais_refus") @db.Decimal(10, 2)
  cinRectoUrl    String?  @map("cin_recto_url")
  cinVersoUrl    String?  @map("cin_verso_url")
  ribPhotoUrl    String?  @map("rib_photo_url")

  // Hub de rattachement (§ /admin/scan/reception, § /admin/bon-distribution)
  // — obligatoire pour un AGENT_HUB, un PLANNER ou un LIVREUR INDIVIDUEL
  // (validé côté API dans POST/PATCH /api/utilisateurs, pas en contrainte DB
  // pour rester nullable pour tous les autres rôles).
  //
  // EXCEPTION : une société de livraison (§ TypeCompteLivreur) n'a pas de quai
  // chez nous — on lui confie des colis par bon d'envoi, elle les emporte et
  // ne revient pas. Le champ lui reste ouvert, il n'est plus exigé
  // (§ hubRequis, lib/comptes-livreur.ts).
  hubId String? @map("hub_id")
  hub   Hub?    @relation("UtilisateurHub", fields: [hubId], references: [id])

  // § /admin/bon-envoi : Bons d'Envoi marqués "Reçu" par cet utilisateur
  // (admin ou agent_hub du hub d'arrivée).
  bonsEnvoiReceptionnes BonEnvoi[] @relation("BonEnvoiReceptionnaire")

  // Rôles supplémentaires accordés ponctuellement par un admin, EN PLUS du
  // rôle réel ci-dessus — ex. un moderateur qui a aussi besoin d'un accès
  // occasionnel à une fonctionnalité réservée aux superviseurs, sans changer
  // son rôle "officiel" (espace de session, libellé UI, etc. restent basés
  // sur `role`). Vérifié par `roleMatches()` (lib/auth.ts) en complément de
  // `role` partout où `requireUser()`/les gardes de page vérifient une liste
  // de rôles autorisés. Restreint à la création/modification (voir la route
  // qui l'expose) aux rôles du même espace applicatif que l'utilisateur
  // ciblé, pour éviter qu'un octroi ne fasse involontairement franchir une
  // frontière d'espace (admin/marchand/terrain).
  rolesSupplementaires Role[] @default([]) @map("roles_supplementaires")

  // Permissions du back-office détenues par ce compte (clés du catalogue de
  // lib/permissions.ts, ex. "colis:read", "comptabilite:read"). Stockées en
  // texte libre plutôt qu'en enum Prisma : le catalogue évolue au rythme des
  // écrans, et une migration de schéma à chaque nouvelle case à cocher serait
  // hors de proportion. Les clés inconnues sont ignorées à la lecture
  // (sanitizePermissions), donc une clé retirée du catalogue n'accorde rien.
  //
  // C'est la liste STOCKÉE qui fait foi — pas le rôle. ROLE_PERMISSIONS ne
  // sert qu'à pré-remplir ce champ (migration des comptes existants, cases
  // pré-cochées à la création). Seule exception : le rôle `admin`, qui détient
  // toujours le catalogue entier quoi que contienne cette colonne
  // (cf. effectivePermissions).
  //
  // Ne gouverne QUE l'espace back-office : les rôles marchand/livreur/ramasseur
  // n'en ont pas l'usage et gardent une liste vide.
  permissions String[] @default([])

  marchand       Marchand?
  marchandMembre MarchandMembre?

  historiqueStatuts  HistoriqueStatutCommande[] @relation("HistoriqueAuteur")
  historiqueProduits HistoriqueProduit[]        @relation("HistoriqueProduitAuteur")
  commandesRamassees Commande[]                 @relation("CommandeRamasseur")
  commandesLivrees   Commande[]                 @relation("CommandeLivreur")
  ramassagesRealises Ramassage[]                @relation("RamassageRamasseur")
  ramassagesInities  Ramassage[]                @relation("RamassageInitiateur")
  commentaires       CommentaireCommande[]
  reclamations       Reclamation[]
  tarifsVilles       TarifLivreurVille[]

  bonsDistribution BonDistribution[] @relation("BonDistributionLivreur")

  // § Planner : tournées qu'il a composées, et tournées qu'il a clôturées au
  // retour du livreur (le plus souvent le même, pas nécessairement — une
  // tournée du matin peut être déchargée par le planner de l'après-midi).
  bonsDistributionPlanifies BonDistribution[] @relation("BonDistributionPlanner")
  bonsDistributionClotures  BonDistribution[] @relation("BonDistributionCloturePar")

  // Tableau Kanban interne (§ /admin/tasks) : une tâche a un assigné (optionnel)
  // et un créateur (toujours renseigné, = l'auteur de la requête POST).
  tachesAssignees         Tache[]                 @relation("TacheAssignee")
  tachesCreees            Tache[]                 @relation("TacheCreateur")
  commentairesTaches      CommentaireTache[]
  equipesTaches           EquipeTacheMembre[]
  historiqueStatutsTaches HistoriqueStatutTache[] @relation("HistoriqueStatutTacheAuteur")
  piecesJointesTaches     PieceJointeTache[]      @relation("PieceJointeTacheAuteur")

  // Comptabilité (§ /admin/comptabilite) : auteur des écritures qu'il a saisies.
  transactions      Transaction[]      @relation("TransactionAuteur")
  commandesStockHub CommandeStockHub[] @relation("CommandeStockHubAuteur")

  // § Power Delivery : remises de colis qu'il a déclenchées.
  remisesPrestataire RemisePrestataire[] @relation("RemisePrestataireAuteur")

  // § Gestion de stock (/admin/stock/**) : admin ayant validé la préparation d'un bon.
  bonsPreparationValidees BonDePreparation[]

  // Traçabilité des actions sensibles (ex. impersonation) qu'il a effectuées
  // en tant qu'admin — voir AuditLog.
  auditLogs AuditLog[] @relation("AuditLogAuteur")

  // § Séparation par domaines : transferts de session dont il est la cible
  // (session ouverte pour son compte sur le domaine métier) et ceux qu'il a
  // émis depuis le back-office. Voir SessionHandoff.
  handoffsRecus SessionHandoff[] @relation("SessionHandoffCible")
  handoffsEmis  SessionHandoff[] @relation("SessionHandoffEmetteur")

  // § Plateformes partenaires : renseigné UNIQUEMENT sur le compte de service
  // d'une plateforme (rôle `plateforme`), au plus un par plateforme. Voir
  // PlateformePartenaire.utilisateurTechnique pour la raison d'être de ce
  // compte.
  plateformeTechnique PlateformePartenaire? @relation("PlateformeUtilisateurTechnique")

  // § Comptes livreurs : transporteur sous-traitant dont ce compte est le
  // compte humain (§ Prestataire.compteLivreurId). Renseigné au plus sur un
  // compte de type `societe` — un livreur individuel n'est le compte de
  // personne d'autre que lui-même.
  prestataireRattache Prestataire? @relation("PrestataireCompteLivreur")

  // § Règlements (/admin/bon-paiement, /admin/factures) : bons de paiement
  // dont il est le BÉNÉFICIAIRE (livreur), et ceux qu'il a émis en tant
  // qu'admin/responsable — deux relations distinctes vers le même modèle,
  // même schéma que planner/clôtureur sur BonDistribution.
  bonsPaiementRecus   BonPaiement[]           @relation("BonPaiementLivreur")
  bonsPaiementEmis    BonPaiement[]           @relation("BonPaiementEmetteur")
  bonsPaiementValides BonPaiement[]           @relation("BonPaiementValidateur")
  ajustementsPaiement AjustementBonPaiement[] @relation("AjustementPaiementAuteur")
  facturesEmises      Facture[]               @relation("FactureEmetteur")
  facturesValidees    Facture[]               @relation("FactureValidateur")
  fraisFacture        FraisFacture[]          @relation("FraisFactureAuteur")

  // § Bon de retour (/admin/bon-retour) : bons qu'il a composés au hub, et
  // bons qu'il est chargé de rapporter au marchand (ramasseur).
  bonsRetourCrees    BonRetour[] @relation("BonRetourCreateur")
  bonsRetourAffectes BonRetour[] @relation("BonRetourRamasseur")

  @@map("utilisateurs")
}

// § Séparation par domaines : jeton de transfert de session entre le domaine
// du back-office et celui des marchands.
//
// Depuis que chaque espace a son propre hôte et que les cookies portent le
// préfixe `__Host-` (liés à l'hôte exact qui les pose), le back-office ne peut
// PLUS écrire un cookie sur un autre domaine — c'est exactement l'isolation
// recherchée. La passerelle légitime qui en dépend passe donc par un jeton à
// usage unique, échangé contre une vraie session sur l'hôte cible (POST
// /api/session-handoff puis GET /api/session-handoff/consume) :
// l'impersonation d'un marchand par un admin (support, dépannage).
//
// Un second usage a existé — l'accès de l'admin à la web app Planner — et a
// disparu avec l'espace `planner` lui-même : le module de planification est
// servi dans le back-office, sur le domaine où l'admin a déjà sa session.
//
// Le jeton brut ne transite que dans l'URL de redirection et n'est jamais
// stocké : seul son hash SHA-256 est écrit ici, comme pour les tokens de
// réinitialisation de mot de passe. Durée de vie 60 s (le temps d'une
// redirection navigateur) et consommation unique (`consommeLe`), parce qu'une
// URL peut se retrouver dans les journaux d'un proxy ou l'historique.
model SessionHandoff {
  id            String    @id @default(uuid())
  tokenHash     String    @unique @map("token_hash")
  // Espace cible ('marchand' à ce jour) — stocké en String plutôt qu'en
  // enum : SessionSpace est une notion applicative (lib/auth.ts) qui n'a pas
  // d'équivalent en base et n'a pas vocation à contraindre le schéma.
  espace        String
  impersonation Boolean   @default(false)
  expireLe      DateTime  @map("expire_le")
  consommeLe    DateTime? @map("consomme_le")
  creeLe        DateTime  @default(now()) @map("cree_le")

  // Compte pour lequel la session sera ouverte sur l'hôte cible.
  utilisateurId String      @map("utilisateur_id")
  utilisateur   Utilisateur @relation("SessionHandoffCible", fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Admin à l'origine du transfert : l'AuditLog garde la trace de l'action,
  // ce lien garde celle du jeton lui-même.
  emisParId String      @map("emis_par_id")
  emisPar   Utilisateur @relation("SessionHandoffEmetteur", fields: [emisParId], references: [id], onDelete: Cascade)

  @@index([expireLe])
  @@map("session_handoffs")
}

// Compteur de rate limiting par clé (ex. "login:<ip>") à fenêtre glissante
// simple, stocké en base plutôt qu'en mémoire process : ce projet tourne en
// environnement serverless (plusieurs instances sans mémoire partagée), donc
// un compteur en mémoire se réinitialiserait à chaque nouvelle instance et
// laisserait passer le bruteforce. Voir lib/rate-limit.ts pour la logique
// d'incrémentation/reset atomique. Pas de purge automatique des entrées
// expirées pour l'instant (volumétrie faible attendue) — à revoir si la
// table grossit significativement.
model RateLimitEntry {
  id           String   @id @default(uuid())
  cle          String   @unique
  compteur     Int      @default(1)
  fenetreDebut DateTime @default(now()) @map("fenetre_debut")

  @@map("rate_limit_entries")
}

// Traçabilité des actions admin sensibles qui ne modifient pas directement un
// enregistrement métier suivi ailleurs (ex. HistoriqueStatutCommande) — pour
// l'instant seulement l'impersonation (accès support admin -> marchand), mais
// pensé pour être réutilisé par d'autres actions sensibles futures
// (changement de rôle/permissions, etc.) sans nouvelle table à chaque fois.
model AuditLog {
  id         String      @id @default(uuid())
  adminId    String      @map("admin_id")
  admin      Utilisateur @relation("AuditLogAuteur", fields: [adminId], references: [id])
  action     String
  cibleType  String?     @map("cible_type")
  cibleId    String?     @map("cible_id")
  adresseIp  String?     @map("adresse_ip")
  horodatage DateTime    @default(now())

  @@index([adminId])
  @@index([cibleType, cibleId])
  @@map("audit_logs")
}

model Marchand {
  id            String             @id @default(uuid())
  utilisateurId String             @unique @map("utilisateur_id")
  utilisateur   Utilisateur        @relation(fields: [utilisateurId], references: [id])
  nomBoutique   String             @map("nom_boutique")
  raisonSociale String?            @map("raison_sociale")
  iceRc         String?            @map("ice_rc")
  typeCompte    TypeCompteMarchand @default(marchand) @map("type_compte")
  ville         String?
  rib           String?

  // § Inscription progressive (lib/marchand-activation.ts).
  //
  // Ces champs étaient exigés au formulaire d'inscription ; ils sont désormais
  // saisis APRÈS, depuis /marchand/profil. Ils restent donc nullable, et leur
  // absence a un sens précis : le dossier n'est pas fini. Tant que cin, ville,
  // adresse, rib, ribPhotoUrl (et Utilisateur.telephone) ne sont pas tous
  // renseignés, le marchand garde l'accès à son espace, à ses colis et à son
  // équipe, mais ni bons, ni ramassages, ni factures — on ne fait pas circuler
  // de la marchandise vers une adresse inconnue, et on n'encaisse pas du COD
  // pour quelqu'un qu'on ne sait pas rembourser.
  //
  // Les nullifier après coup REFERME ces fonctions : c'est la même règle, lue
  // au même endroit, et c'est voulu.
  cin              String?        @map("cin")
  siteWeb          String?        @map("site_web")
  adresse          String?
  nomBanque        String?        @map("nom_banque")
  ribPhotoUrl      String?        @map("rib_photo_url")
  villeRamassage   String?        @map("ville_ramassage")
  registreCommerce String?        @map("registre_commerce")
  // RF-22 : un compte marchand créé par auto-inscription reste en attente
  // tant que l'admin ne l'a pas approuvé.
  //
  // Ce que cette attente bloque a changé avec l'inscription progressive : plus
  // la CONNEXION (Utilisateur.actif vaut true dès l'inscription, et n'est mis
  // à false que par une suspension), mais les bons, les ramassages et les
  // factures — le SECOND verrou, à côté de la complétude du dossier ci-dessus.
  // Les deux doivent tomber pour que le marchand opère : un dossier complet
  // n'approuve pas, une approbation ne complète pas.
  statut           StatutMarchand @default(en_attente_validation)

  // Ramassage récurrent (modèle hybride, §5.6 / RG-15 / RG-16)
  ramassageRecurrentActif Boolean @default(false) @map("ramassage_recurrent_actif")
  ramassageJours          String? @map("ramassage_jours")
  ramassageCreneauHoraire String? @map("ramassage_creneau_horaire")

  dateCreation DateTime @default(now()) @map("date_creation")

  // § Facturation marchand (/admin/factures) : tarif appliqué à toute ville
  // sans ligne dédiée dans TarifMarchandVille. Distinct des frais du livreur
  // (Utilisateur.fraisLivraison / fraisRefus) — ceux-ci sont ce que la
  // plateforme PAIE, ceux-là ce qu'elle FACTURE.
  fraisLivraison Decimal? @map("frais_livraison") @db.Decimal(10, 2)
  fraisRetour    Decimal? @map("frais_retour") @db.Decimal(10, 2)

  adresses        AdresseMarchand[]
  commandes       Commande[]
  ramassages      Ramassage[]
  bonsLivraison   BonDeLivraison[]
  bonsPreparation BonDePreparation[]
  marchandises    Marchandise[]
  membres         MarchandMembre[]
  reclamations    Reclamation[]
  produits        Produit[]
  tarifsVilles    TarifMarchandVille[]
  factures        Facture[]
  bonsRetour      BonRetour[]

  // § Plateformes partenaires : canaux de vente depuis lesquels ce marchand
  // nous est arrivé (ou auxquels il a été rattaché après coup s'il s'était
  // déjà inscrit en direct). Vide pour l'immense majorité des marchands.
  comptesExternes CompteMarchandExterne[]

  @@map("marchands")
}

// RF : le titulaire du compte marchand (Marchand.utilisateurId) peut inviter
// d'autres comptes Utilisateur (role "marchand") à accéder à sa boutique —
// ex. un employé qui gère les colis sans être le titulaire légal. L'accès est
// total sur les données de la boutique (pas de permissions fines pour ce
// scénario) : voir lib/marchand-scope.ts, résolu en plus du propriétaire
// direct sur toutes les routes marchand.
model MarchandMembre {
  id            String      @id @default(uuid())
  marchandId    String      @map("marchand_id")
  marchand      Marchand    @relation(fields: [marchandId], references: [id])
  utilisateurId String      @unique @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  dateAjout     DateTime    @default(now()) @map("date_ajout")

  @@index([marchandId])
  @@map("marchand_membres")
}

// Catalogue produit propre à chaque marchand (§ dropdown "Marchandise" du
// formulaire colis) : un marchand ne voit et ne sélectionne que les
// marchandises qu'il a lui-même déjà saisies dans son espace.
model Marchandise {
  id           String   @id @default(uuid())
  marchandId   String   @map("marchand_id")
  marchand     Marchand @relation(fields: [marchandId], references: [id])
  nom          String   @map("nom_marchandise")
  qteStock     Int      @default(0) @map("qte_stock")
  prix         Decimal  @db.Decimal(10, 2)
  dateCreation DateTime @default(now()) @map("date_creation")

  commandes Commande[]

  @@unique([marchandId, nom])
  @@index([marchandId])
  @@map("marchandises")
}

model AdresseMarchand {
  id              String   @id @default(uuid())
  marchandId      String   @map("marchand_id")
  marchand        Marchand @relation(fields: [marchandId], references: [id])
  libelle         String
  adresseComplete String   @map("adresse_complete")
  estParDefaut    Boolean  @default(false) @map("est_par_defaut")

  ramassages Ramassage[]

  @@index([marchandId])
  @@map("adresses_marchand")
}

// ============================================================
// Gestion inventaire (espace marchand — page "Ajouter Produit")
// ============================================================

// Verrou fonctionnel côté admin (page "Modifier produit") : tant qu'un
// produit est pas_encore_recu, les champs de saisie de quantité (réception,
// retrait) restent désactivés côté UI et rejetés côté API — l'admin doit
// d'abord basculer explicitement sur "recu" avant de pouvoir taper les
// quantités réellement constatées en entrepôt. Empêche la saisie accidentelle.
enum StatutReceptionProduit {
  pas_encore_recu
  recu
}

// Distinct de Marchandise (catalogue simple qui alimente le formulaire colis) :
// un Produit porte une référence (SKU) éditable, une photo et, en option, des
// variantes (couleur/taille…) ayant chacune leur propre référence et stock.
// La référence est unique par marchand seulement (deux marchands peuvent
// réutiliser le même SKU interne), d'où l'@@unique composite ci-dessous.
// Cycle de vie du stock : le marchand saisit une quantité (quantiteEnCours),
// que l'admin déplace vers quantiteRecue une fois la marchandise physiquement
// vérifiée et réceptionnée en entrepôt (voir POST /api/produits/[id]/reception
// et /api/produits/variantes/[id]/reception). Suivi au niveau variante quand
// variantesActivees est vrai, sinon directement sur le produit.
model Produit {
  id                String                 @id @default(uuid())
  marchandId        String                 @map("marchand_id")
  marchand          Marchand               @relation(fields: [marchandId], references: [id])
  nom               String                 @map("nom_produit")
  reference         String                 @map("reference")
  quantiteEnCours   Int                    @default(0) @map("quantite_en_cours")
  quantiteRecue     Int                    @default(0) @map("quantite_recue")
  statutReception   StatutReceptionProduit @default(pas_encore_recu) @map("statut_reception")
  // Emplacement d'entrepôt (admin uniquement) — n'a de sens que quand le
  // produit ne suit pas ses variantes individuellement (sinon voir
  // ProduitVariante.rayonnage).
  rayonnage         String?                @map("rayonnage")
  note              String?                @map("note")
  photoUrl          String?                @map("photo_url")
  variantesActivees Boolean                @default(false) @map("variantes_activees")
  dateCreation      DateTime               @default(now()) @map("date_creation")

  variantes  ProduitVariante[]
  historique HistoriqueProduit[]
  commandes  Commande[]

  @@unique([marchandId, reference])
  @@index([marchandId])
  @@map("produits")
}

model ProduitVariante {
  id              String  @id @default(uuid())
  produitId       String  @map("produit_id")
  produit         Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  nom             String  @map("nom_variante")
  reference       String  @map("reference")
  quantiteEnCours Int     @default(0) @map("quantite_en_cours")
  quantiteRecue   Int     @default(0) @map("quantite_recue")
  rayonnage       String? @map("rayonnage")

  @@unique([produitId, reference])
  @@index([produitId])
  @@map("produit_variantes")
}

// Journal des mouvements de stock (ajout, réception, retrait) affiché dans
// l'historique de la page admin "Modifier produit" — même logique que
// CommentaireCommande : un texte pré-formaté plutôt qu'un modèle typé par
// mouvement, l'affichage n'ayant besoin que du texte et de la date.
model HistoriqueProduit {
  id           String   @id @default(uuid())
  produitId    String   @map("produit_id")
  produit      Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  texte        String
  dateCreation DateTime @default(now()) @map("date_creation")

  // Agent qui a réalisé le mouvement — sans lui, un écart de comptage en
  // entrepôt n'est imputable à personne (§ validation de réception et retrait,
  // /api/produits/**). Même rôle que HistoriqueStatutCommande.utilisateurId
  // sur le pipeline colis.
  //
  // NULLABLE à dessein, et ce n'est pas une facilité : les lignes écrites
  // avant la migration 20260826110000 n'ont pas d'auteur connu. Les rattacher
  // au compte admin d'amorçage pour satisfaire un NOT NULL fabriquerait une
  // preuve — exactement l'inverse de ce que cette colonne existe pour offrir.
  // L'écran affiche « — » sur ces lignes, ce qui est la vérité.
  //
  // onDelete SetNull plutôt que Cascade : supprimer un compte ne doit jamais
  // effacer l'historique de l'entrepôt.
  utilisateurId String?      @map("utilisateur_id")
  utilisateur   Utilisateur? @relation("HistoriqueProduitAuteur", fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([produitId])
  @@index([utilisateurId])
  @@map("historique_produits")
}

// ============================================================
// Cœur métier
// ============================================================

model Commande {
  id                  String         @id @default(uuid())
  codeSuivi           String         @unique @map("code_suivi")
  // Référence de suivi du partenaire/marchand fournie à l'import Excel en
  // masse (colonne "Code Suivi" du fichier, cf. app/api/commandes/import/route.ts)
  // — sert de clé métier anti-doublon (@@unique ci-dessous, un même fichier
  // réimporté ou une même commande partenaire soumise deux fois est bloquée)
  // plutôt que d'être seulement embarquée en texte libre dans `notes`.
  // Nullable : PostgreSQL ne compare pas les NULL entre eux dans un index
  // unique, donc les colis sans référence partenaire (création manuelle,
  // import "stock") ne sont jamais bloqués entre eux.
  codeSuiviPartenaire String?        @map("code_suivi_partenaire")
  marchandId          String         @map("marchand_id")
  marchand            Marchand       @relation(fields: [marchandId], references: [id])
  clientNom           String         @map("client_nom")
  clientTelephone     String         @map("client_telephone")
  ville               String
  adresse             String
  codePostal          String?        @map("code_postal")
  produitDescription  String?        @map("produit_description")
  marchandiseId       String?        @map("marchandise_id")
  marchandise         Marchandise?   @relation(fields: [marchandiseId], references: [id])
  // Résolution propre d'un colis "en stock" (enStock=true) vers sa fiche
  // Produit (inventaire, § import Excel mode "stock" : la colonne Ref est
  // rapprochée du SKU Produit.reference du marchand) — permet notamment
  // d'afficher la vraie photo (Produit.photoUrl) sans repasser par un
  // matching texte. Reste null pour un colis normal ou une Ref non résolue
  // (produitDescription garde alors le texte brut en repli).
  produitId           String?        @map("produit_id")
  produit             Produit?       @relation(fields: [produitId], references: [id])
  quantite            Int            @default(1)
  poidsKg             Decimal?       @map("poids_kg") @db.Decimal(6, 2)
  montantCod          Decimal        @map("montant_cod") @db.Decimal(10, 2)
  notes               String?
  // RG colis échange : un colis peut remplacer un colis déjà livré/retourné
  // chez le même client (auto-relation, résolue côté API via le code_suivi saisi).
  colisARemplacerId   String?        @map("colis_a_remplacer_id")
  colisARemplacer     Commande?      @relation("ColisRemplacement", fields: [colisARemplacerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  remplacements       Commande[]     @relation("ColisRemplacement")
  ouvrir              Boolean        @default(false)
  fragile             Boolean        @default(false)
  // Échange : le livreur doit récupérer l'ancien colis chez le client et
  // livrer celui-ci à la place (distinct de colisARemplacer, qui ne fait que
  // lier deux commandes — ce booléen pilote le comportement de la tournée).
  aRemplacer          Boolean        @default(false)
  // Marchandise stockée dans l'entrepôt de la société (par opposition à un
  // envoi géré directement depuis le stock du marchand).
  enStock             Boolean        @default(false)
  statut              StatutCommande @default(nouveau_colis)
  etatPaiement        EtatPaiement   @default(non_paye) @map("etat_paiement")
  aRisque             Boolean        @default(false) @map("a_risque")

  ramasseurId String?      @map("ramasseur_id")
  ramasseur   Utilisateur? @relation("CommandeRamasseur", fields: [ramasseurId], references: [id])
  ramassageId String?      @map("ramassage_id")
  ramassage   Ramassage?   @relation(fields: [ramassageId], references: [id])

  // Livreur en charge de la distribution — distinct du ramasseur (§ modèle
  // "poste de pilotage colis" admin, assignable indépendamment du ramassage).
  livreurId String?      @map("livreur_id")
  livreur   Utilisateur? @relation("CommandeLivreur", fields: [livreurId], references: [id])

  // Bon de livraison marchand (regroupement de colis en_attente avant confirmation, §5.7)
  bonLivraisonId String?         @map("bon_livraison_id")
  bonLivraison   BonDeLivraison? @relation(fields: [bonLivraisonId], references: [id])

  // Bon de préparation stock (§ Gestion de stock /admin/stock/**, colis enStock
  // uniquement) — pendant du bonLivraisonId ci-dessus pour le pipeline stock.
  bonPreparationId String?           @map("bon_preparation_id")
  bonPreparation   BonDePreparation? @relation(fields: [bonPreparationId], references: [id])

  // Bon d'envoi (§ Transit inter-hubs /admin/bon-envoi) — regroupe des colis
  // recu_au_hub (ou ramasse+enStock) vers un hub d'arrivée ; reste renseigné
  // après réception (lien historique), cf. bonLivraisonId ci-dessus.
  bonEnvoiId String?   @map("bon_envoi_id")
  bonEnvoi   BonEnvoi? @relation(fields: [bonEnvoiId], references: [id])

  // Bon de Distribution (§ Distribution locale /admin/bon-distribution) —
  // regroupe des colis recu_au_hub d'un même hub local vers un livreur pour sa
  // tournée ; reste renseigné après mise en distribution (lien historique).
  bonDistributionId String?          @map("bon_distribution_id")
  bonDistribution   BonDistribution? @relation(fields: [bonDistributionId], references: [id])

  // Rémunération du LIVREUR pour CE colis, figée à la clôture de la tournée
  // (§ /admin/bon-paiement). Le tarif était déjà résolu colis par colis à la
  // clôture (tarifPourColis, lib/bon-distribution.ts) mais seule la somme
  // était conservée dans BonDistribution.gainLivreur : impossible d'éditer
  // une fiche de paie détaillée au colis, ni de justifier un montant à un
  // livreur qui conteste une ligne.
  //
  // `fraisLivreurLivre` fige la NATURE du frais (livraison ou refus) au même
  // instant, pour la même raison que LigneFacture.livre côté marchand : le
  // statut du colis continue d'évoluer après la paie — un `retourne_au_hub`
  // devient `retourne` à la remise au marchand — et le déduire du statut
  // courant ferait bouger un document déjà signé.
  //
  // Les deux restent nuls pour les tournées clôturées AVANT l'introduction de
  // ces colonnes lorsque la reconstitution n'a pas pu être vérifiée
  // (cf. la migration ajout_frais_livreur_colis).
  fraisLivreur      Decimal? @map("frais_livreur") @db.Decimal(10, 2)
  fraisLivreurLivre Boolean? @map("frais_livreur_livre")

  // Bon de Retour (§ /admin/bon-retour) — regroupe des colis en échec de
  // livraison à rendre à leur marchand ; reste renseigné après la remise
  // (lien historique), cf. bonLivraisonId ci-dessus.
  bonRetourId String?    @map("bon_retour_id")
  bonRetour   BonRetour? @relation(fields: [bonRetourId], references: [id])

  // Résolution best-effort (normalisation, cf. lib/hub-stock.ts
  // normaliserVille) du champ ville (texte libre) vers une Ville connue du
  // référentiel — nullable et non bloquant : ville reste la source de
  // vérité saisie par le marchand/admin, villeId n'est qu'un enrichissement
  // pour le routage automatique (cf. lib/hub-envoi.ts).
  villeId  String? @map("ville_id")
  villeRef Ville?  @relation(fields: [villeId], references: [id])

  // Hub où le colis se trouve physiquement, réceptionné soit via le scan de
  // quai (§ /admin/scan/reception, POST /api/commandes/scan-reception,
  // ramasse → recu_au_hub) soit via un Bon d'Envoi (§ /admin/bon-envoi,
  // POST /api/bons-envoi/[id]/marquer-recu, en_transit → recu_au_hub) —
  // distinct de bonPreparation/hub-stock (lib/hub-stock.ts) qui vise le
  // pipeline colis "stock". Jamais renseigné à la création.
  hubActuelId      String?   @map("hub_actuel_id")
  hubActuel        Hub?      @relation("CommandeHubActuel", fields: [hubActuelId], references: [id])
  dateReceptionHub DateTime? @map("date_reception_hub")

  source SourceCommande @default(manuel)

  dateCreation     DateTime  @default(now()) @map("date_creation")
  dateConfirmation DateTime? @map("date_confirmation")
  dateCollecte     DateTime? @map("date_collecte")
  dateLivraison    DateTime? @map("date_livraison")

  gpsLivraisonLat       Decimal?  @map("gps_livraison_lat") @db.Decimal(9, 6)
  gpsLivraisonLng       Decimal?  @map("gps_livraison_lng") @db.Decimal(9, 6)
  signatureUrl          String?   @map("signature_url")
  photoPreuveUrl        String?   @map("photo_preuve_url")
  motifRetour           String?   @map("motif_retour")
  // § /livreur/tournee, action "Reporté" (PATCH /api/livreur/colis/[id]/statut) :
  // date de nouvelle tentative de livraison choisie par le livreur — distincte
  // de motifRetour (qui porte le motif du report), nullable pour tous les
  // colis jamais reportés.
  dateNouvelleLivraison DateTime? @map("date_nouvelle_livraison")
  // Photo de la CIN client (data URL), même pattern que les preuves ci-dessus
  // — pas de stockage objet dédié pour ce scénario.
  cinUrl                String?   @map("cin_url")

  historique   HistoriqueStatutCommande[]
  commentaires CommentaireCommande[]
  reclamations Reclamation[]

  // § Facturation marchand : au plus une ligne de facture par colis (unicité
  // portée par LigneFacture.commandeId) — c'est la garantie
  // anti-double-facturation.
  ligneFacture LigneFacture?

  // § Sous-traitance par API : les remises de ce colis à un prestataire, dont
  // une seule active à la fois (cf. RemisePrestataire).
  remisesPrestataire RemisePrestataire[]

  // Garde-fou anti-doublon import (bug rapporté : réimporter le même fichier
  // ne remonte aucune erreur et duplique les colis) — un même marchand ne
  // peut pas avoir deux commandes avec la même référence partenaire. NULL
  // n'est jamais considéré égal à NULL par Postgres dans un index unique,
  // donc les colis sans référence partenaire restent illimités.
  @@unique([marchandId, codeSuiviPartenaire], map: "commandes_marchand_ref_partenaire_key")
  @@index([marchandId])
  @@index([statut])
  @@index([ramassageId])
  @@index([bonLivraisonId])
  @@index([livreurId])
  @@index([marchandiseId])
  @@index([produitId])
  @@index([colisARemplacerId])
  @@index([bonPreparationId])
  @@index([hubActuelId])
  @@index([bonEnvoiId])
  @@index([bonDistributionId])
  @@index([bonRetourId])
  @@index([villeId])
  @@map("commandes")
}

// ============================================================
// Bon de livraison marchand (§5.7)
// ============================================================

// Regroupe des colis "en_attente" du marchand en un lot confirmé d'un coup :
// génère un numéro (BL-AAAA-MMJJ-NNN) et fait passer les colis en "confirmee".
model BonDeLivraison {
  id              String   @id @default(uuid())
  numero          String   @unique
  marchandId      String   @map("marchand_id")
  marchand        Marchand @relation(fields: [marchandId], references: [id])
  nbColis         Int      @map("nb_colis")
  montantTotalCod Decimal  @map("montant_total_cod") @db.Decimal(10, 2)
  dateGeneration  DateTime @default(now()) @map("date_generation")

  commandes Commande[]

  @@index([marchandId])
  @@map("bons_de_livraison")
}

// ============================================================
// Bon de préparation stock (§ Gestion de stock /admin/stock/**)
// ============================================================

// Regroupe des colis "stock" (enStock=true) au statut pret_pour_preparation
// en un lot à préparer ensemble à l'entrepôt — pendant de BonDeLivraison pour
// le pipeline stock (aucun BL n'est généré pour ces colis, cf. commentaire
// sur Commande.enStock). Générés groupés par marchand (un bon = un marchand),
// numéro BPR-AAAA-MMJJ-NNN (lib/codes.ts, même schéma que BL). Le statut
// porte l'état "en préparation" / "préparée" (voir StatutBonPreparation) :
// les colis eux-mêmes ne changent de statut qu'à la validation, cf.
// POST /api/bons-preparation/[id]/valider.
model BonDePreparation {
  id             String               @id @default(uuid())
  numero         String               @unique
  marchandId     String               @map("marchand_id")
  marchand       Marchand             @relation(fields: [marchandId], references: [id])
  nbColis        Int                  @map("nb_colis")
  statut         StatutBonPreparation @default(en_attente)
  dateGeneration DateTime             @default(now()) @map("date_generation")
  dateValidation DateTime?            @map("date_validation")
  validateurId   String?              @map("validateur_id")
  validateur     Utilisateur?         @relation(fields: [validateurId], references: [id])

  commandes Commande[]

  @@index([marchandId])
  @@map("bons_de_preparation")
}

// ============================================================
// Bon d'envoi (§ Transit inter-hubs /admin/bon-envoi)
// ============================================================

enum StatutBonEnvoi {
  nouveau
  recu
}

// Regroupe des colis recu_au_hub (ou ramasse+enStock, § Gestion de stock) vers
// un même hub d'arrivée en un lot numéroté (BE-AAAA-MMJJ-NNN, lib/codes.ts,
// même schéma que BL/BPR) : à la création les colis passent en_transit
// (statut BE 'nouveau'), puis l'agent du hub de destination (ou un admin)
// clique "Marquer comme Reçu" (POST /api/bons-envoi/[id]/marquer-recu) — le
// BE passe 'recu' et tous ses colis basculent recu_au_hub d'un coup. Un BE
// ne vise volontairement qu'un seul Hub : la réception bascule tout le bon
// en une seule action par un seul agent, donc il ne peut couvrir qu'un seul
// quai physique. Sous le modèle plat Hub↔Ville, n'importe quel hub peut
// être source ou destination d'un BE (éligibilité : villeDestination.hubId
// !== hub actuel du colis, cf. lib/hub-envoi.ts) — il n'y a plus de "Hub
// Central" privilégié pour ce flux.
model BonEnvoi {
  id               String         @id @default(uuid())
  numero           String         @unique

  // DEUX NATURES DE BON, MUTUELLEMENT EXCLUSIVES — exactement une des deux
  // colonnes ci-dessous est renseignée, jamais les deux, jamais aucune :
  //
  //   hubDestinationId → TRANSIT INTERNE. Le bon vise un de nos quais. La
  //     destination est DÉDUITE de la ville du colis (lib/hub-envoi.ts), et la
  //     réception se fait par « Marquer comme reçu » côté hub d'arrivée.
  //
  //   prestataireId → REMISE SOUS-TRAITÉE. Le bon désigne un TRANSPORTEUR,
  //     choisi à la main par l'opérateur. Ici la ville du colis ne décide plus
  //     rien : confier un colis à tel transporteur est un arbitrage commercial,
  //     pas un routage géographique. Tant que la carte « quel prestataire sert
  //     quelle ville » n'est pas figée (§ SOUS_TRAITANCE.md), aucun contrôle de
  //     couverture ne s'y oppose — une ville absente de la grille du
  //     transporteur est signalée à l'écran, jamais refusée, et son coût
  //     d'achat reste NULL. Surtout pas zéro : zéro dirait « gratuit » et
  //     gonflerait la marge d'un montant inventé.
  //
  // L'exclusivité est garantie en base par un CHECK posé à la main dans la
  // migration — Prisma ne sait pas l'exprimer ici, même procédé que l'index
  // partiel de RemisePrestataire. Sans lui, un bon pourrait viser un quai ET un
  // transporteur, et plus rien ne dirait où part le colis.
  hubDestinationId String?        @map("hub_destination_id")
  hubDestination   Hub?           @relation("BonEnvoiHubDestination", fields: [hubDestinationId], references: [id])
  prestataireId    String?        @map("prestataire_id")
  prestataire      Prestataire?   @relation(fields: [prestataireId], references: [id])

  // Sur un bon sous-traité, 'recu' ne dit pas « arrivé à un quai à nous » mais
  // « pris en charge par le transporteur » : les colis restent en_transit, et
  // leur sort nous revient ensuite par son API ou son fichier de suivi.
  statut           StatutBonEnvoi @default(nouveau)
  nbColis          Int            @map("nb_colis")
  dateGeneration   DateTime       @default(now()) @map("date_generation")
  dateReception    DateTime?      @map("date_reception")
  receptionnaireId String?        @map("receptionnaire_id")
  receptionnaire   Utilisateur?   @relation("BonEnvoiReceptionnaire", fields: [receptionnaireId], references: [id])

  commandes          Commande[]
  // Colis de ce bon remis au prestataire de l'agence par son API — à la place
  // de l'export Excel, pour les villes qui ont un identifiant chez lui.
  remisesPrestataire RemisePrestataire[]

  @@index([hubDestinationId])
  @@index([prestataireId])
  @@map("bons_envoi")
}

// ============================================================
// Bon de distribution (§ Distribution locale /admin/bon-distribution)
// ============================================================

// État du Bon de Distribution lui-même : 'nouveau' n'est jamais persisté en
// pratique — la ligne n'est créée en base qu'au clic "Valider & imprimer"
// (POST /api/bons-distribution), directement en 'en_cours' (numéro +
// affectation colis + livreur dans la même transaction). La valeur 'nouveau'
// reste dans l'enum pour représenter l'état affiché côté client avant cette
// création (composition du bon encore en mémoire, aucune ligne en base).
enum StatutBonDistribution {
  nouveau
  en_cours
  // Tournée rentrée au dépôt : tous les colis non livrés ont été scannés au
  // retour par le Planner et la reddition de caisse est enregistrée. C'est
  // cet état — et pas un statut de colis — qui fait disparaître la tournée de
  // la feuille de route du livreur (§ /livreur/colis).
  cloture
}

// Regroupe des colis recu_au_hub d'un hub local vers un même livreur pour sa
// tournée (BD-AAAA-MMJJ-NNN, lib/codes.ts) : à la création (POST
// /api/bons-distribution, admin only), les colis sélectionnés passent
// mise_en_distribution et se voient assigner ce livreur (Commande.livreurId)
// — pas de second état "reçu" comme BonEnvoi, la distribution est locale et
// se conclut par le suivi normal du colis (statut livre/refuse/... hors de ce
// module). La "zone" de l'étape 1 du wizard est directement le Hub existant
// (§ /admin/hubs) — pas de niveau intermédiaire dédié. Éligibilité livreur :
// un livreur ne couvre plus que son unique Hub de rattachement
// (Utilisateur.hubId), plus de granularité par quartier.
model BonDistribution {
  id             String                @id @default(uuid())
  numero         String                @unique
  livreurId      String                @map("livreur_id")
  livreur        Utilisateur           @relation("BonDistributionLivreur", fields: [livreurId], references: [id])
  hubId          String                @map("hub_id")
  hub            Hub                   @relation("BonDistributionHub", fields: [hubId], references: [id])
  statut         StatutBonDistribution @default(en_cours)
  nbColis        Int                   @map("nb_colis")
  dateGeneration DateTime              @default(now()) @map("date_generation")

  // Planificateur qui a composé la tournée (rôle planner, ou admin en
  // dépannage) — nullable pour les bons créés avant l'introduction du rôle.
  // Alimente la ligne d'historique "Affecté à la tournée [n°] par [nom]".
  plannerId String?      @map("planner_id")
  planner   Utilisateur? @relation("BonDistributionPlanner", fields: [plannerId], references: [id])

  // --- Clôture / déchargement au retour au dépôt -------------------------
  // Tout ce bloc est null tant que statut != cloture ; il est écrit d'un seul
  // coup, en transaction, par POST /api/bons-distribution/[id]/cloturer.
  dateCloture      DateTime?    @map("date_cloture")
  clotureParId     String?      @map("cloture_par_id")
  cloturePar       Utilisateur? @relation("BonDistributionCloturePar", fields: [clotureParId], references: [id])
  nbColisLivres    Int?         @map("nb_colis_livres")
  // Colis non livrés effectivement scannés au retour au hub (= le nombre de
  // colis physiquement récupérés par le Planner).
  nbColisRetournes Int?         @map("nb_colis_retournes")

  // Volet caisse — le livreur ne déduit RIEN de ce qu'il a collecté : il
  // remet le brut. montantCrbtAttendu = somme des montantCod des colis livrés
  // de cette tournée, figée au moment de la clôture ; montantRemis = ce que
  // le Planner a réellement compté. La clôture est refusée si montantRemis <
  // montantCrbtAttendu (tolérance zéro sur le manquant), d'où un ecartCaisse
  // toujours >= 0 (un excédent reste possible et tracé).
  montantCrbtAttendu Decimal? @map("montant_crbt_attendu") @db.Decimal(10, 2)
  montantRemis       Decimal? @map("montant_remis") @db.Decimal(10, 2)
  ecartCaisse        Decimal? @map("ecart_caisse") @db.Decimal(10, 2)

  // Volet rémunération, calculé mais JAMAIS déduit de la caisse ci-dessus :
  // (colis livrés x tarif livraison) + (colis retournés x tarif refus), tarifs
  // résolus par ville (TarifLivreurVille) avec repli sur
  // Utilisateur.fraisLivraison/fraisRefus. Constitue le solde à payer au
  // livreur, réglé séparément (§ Bon de paiement livreur).
  gainLivreur Decimal?  @map("gain_livreur") @db.Decimal(10, 2)
  gainRegleLe DateTime? @map("gain_regle_le")

  // Bon de Paiement qui a réglé ce gain (§ /admin/bon-paiement). Renseigné en
  // même temps que gainRegleLe, dans la même transaction : ce lien porte le
  // "par quel document", gainRegleLe le "quand". Une tournée dont le gain
  // n'est pas encore réglé a les deux à null — c'est le critère d'éligibilité
  // à un nouveau bon.
  bonPaiementId String?      @map("bon_paiement_id")
  bonPaiement   BonPaiement? @relation(fields: [bonPaiementId], references: [id])

  // Écriture comptable d'entrée de caisse générée à la clôture (§
  // /admin/comptabilite) — 1-1, jamais recréée si la tournée est rouverte.
  transactionId String?      @unique @map("transaction_id")
  transaction   Transaction? @relation("TransactionRemiseTournee", fields: [transactionId], references: [id])

  commandes Commande[]

  @@index([livreurId])
  @@index([hubId])
  @@index([statut])
  @@index([bonPaiementId])
  @@map("bons_distribution")
}

model HistoriqueStatutCommande {
  id            String          @id @default(uuid())
  commandeId    String          @map("commande_id")
  commande      Commande        @relation(fields: [commandeId], references: [id])
  ancienStatut  StatutCommande? @map("ancien_statut")
  nouveauStatut StatutCommande  @map("nouveau_statut")
  utilisateurId String          @map("utilisateur_id")
  utilisateur   Utilisateur     @relation("HistoriqueAuteur", fields: [utilisateurId], references: [id])
  // Hub concerné par cette transition — renseigné sur l'entrée "recu_au_hub"
  // créée par le scan AGENT_HUB (§ /admin/scan/reception) ainsi que sur les
  // entrées "en_transit"/"recu_au_hub" créées par un Bon d'Envoi
  // (§ /admin/bon-envoi), null pour toutes les autres entrées.
  hubId         String?         @map("hub_id")
  hub           Hub?            @relation(fields: [hubId], references: [id])
  // Message explicite affiché dans l'historique (ex. "Colis bien réceptionné
  // au Hub Casablanca") — sans lui, l'historique n'afficherait que le
  // changement de statut brut, sans contexte métier.
  note          String?
  horodatage    DateTime        @default(now())

  @@index([commandeId])
  @@index([hubId])
  @@map("historique_statuts_commande")
}

// Notes internes libres sur un colis (suivi call-center), affichées avec
// l'historique de statut dans la vue "circuit" du colis (admin).
model CommentaireCommande {
  id            String      @id @default(uuid())
  commandeId    String      @map("commande_id")
  commande      Commande    @relation(fields: [commandeId], references: [id])
  utilisateurId String      @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  texte         String
  dateCreation  DateTime    @default(now()) @map("date_creation")

  @@index([commandeId])
  @@map("commentaires_commande")
}

// ============================================================
// Ramassage (§5.6)
// ============================================================

model Ramassage {
  id             String                @id @default(uuid())
  marchandId     String                @map("marchand_id")
  marchand       Marchand              @relation(fields: [marchandId], references: [id])
  adresseId      String                @map("adresse_id")
  adresse        AdresseMarchand       @relation(fields: [adresseId], references: [id])
  datePrevue     DateTime              @map("date_prevue") @db.Date
  creneauHoraire String?               @map("creneau_horaire")
  modeCreation   ModeCreationRamassage @map("mode_creation")
  // Trace qui a déclenché une tournée manuelle (marchand ou admin) ;
  // null pour les tournées générées par le planificateur récurrent (RG-16).
  initieParId    String?               @map("initie_par")
  initiePar      Utilisateur?          @relation("RamassageInitiateur", fields: [initieParId], references: [id])
  nbColisEstimes Int?                  @map("nb_colis_estimes")
  nbColisReels   Int                   @default(0) @map("nb_colis_reels")
  ramasseurId    String?               @map("ramasseur_id")
  ramasseur      Utilisateur?          @relation("RamassageRamasseur", fields: [ramasseurId], references: [id])
  statut         StatutRamassage       @default(en_attente)

  commandes Commande[]

  @@index([marchandId, datePrevue])
  @@map("ramassages")
}

// ============================================================
// Autres modules
// ============================================================

model ListeNoire {
  id           String          @id @default(uuid())
  type         TypeListeNoire
  valeur       String
  nomAssocie   String?         @map("nom_associe")
  motif        MotifListeNoire
  niveauRisque NiveauRisque    @map("niveau_risque")
  dateCreation DateTime        @default(now()) @map("date_creation")

  @@index([type, valeur])
  @@map("liste_noire")
}

// Réclamation marchand (SAV) : optionnellement rattachée à un colis, suivie
// par le back-office (statut + réponse). Un seul niveau de suivi (pas de fil
// de discussion multi-messages) pour ce scénario.
model Reclamation {
  id            String            @id @default(uuid())
  marchandId    String            @map("marchand_id")
  marchand      Marchand          @relation(fields: [marchandId], references: [id])
  commandeId    String?           @map("commande_id")
  commande      Commande?         @relation(fields: [commandeId], references: [id])
  utilisateurId String            @map("utilisateur_id")
  utilisateur   Utilisateur       @relation(fields: [utilisateurId], references: [id])
  sujet         String
  message       String
  statut        StatutReclamation @default(ouverte)
  reponse       String?
  dateCreation  DateTime          @default(now()) @map("date_creation")
  dateReponse   DateTime?         @map("date_reponse")

  @@index([marchandId])
  @@index([commandeId])
  @@map("reclamations")
}

// ============================================================
// Zonage logistique
// ============================================================

// Référentiel géographique national plat (Hub ↔ Ville, sans niveau
// intermédiaire) : chaque Ville est rattachée à exactement un Hub. Sert au
// routage inter-hubs (§ /admin/bon-envoi, éligibilité générique
// villeDestination.hubId !== hub actuel du colis, cf. lib/hub-envoi.ts) et à
// la distribution locale (§ /admin/bon-distribution, un livreur ne couvre
// que son unique Hub de rattachement). Distinct des champs "ville" en texte
// libre (Commande.ville, Marchand.ville, Utilisateur.zonePrincipale/
// zoneSecondaire) qui restent inchangés.
model Hub {
  id        String  @id @default(uuid())
  nom       String  @unique
  ville     String
  adresse   String?
  telephone String?
  // Vrai pour le hub central (entrepôt principal où arrive la marchandise
  // "stock" avant préparation, cf. lib/hub-stock.ts) — au plus un hub central
  // en pratique, mais pas contraint en DB.
  isCentral Boolean @default(false) @map("is_central")

  // § Sous-traitance (/admin/prestataires) — non nul = ce hub est une AGENCE
  // d'un prestataire externe : les colis y sont remis au prestataire qui livre
  // lui-même, il n'y a donc ni livreur interne rattaché ni Bon de Distribution
  // dessus. Null = hub interne, fonctionnement historique inchangé (livreurs,
  // ramasseurs, § /admin/bon-distribution). C'est volontairement le SEUL
  // marqueur de sous-traitance : comme Ville.hubId désigne déjà qui couvre une
  // ville, basculer une ville de l'interne vers un prestataire (et retour) ne
  // demande que de la déplacer d'un hub à l'autre, sans migration ni champ
  // supplémentaire à tenir synchronisé.
  prestataireId String?      @map("prestataire_id")
  prestataire   Prestataire? @relation(fields: [prestataireId], references: [id])

  villes Ville[]

  // § /admin/scan/reception : agents hub et livreurs rattachés, colis
  // réceptionnés à ce hub, historique des réceptions (cf.
  // Utilisateur.hubId, Commande.hubActuelId, HistoriqueStatutCommande.hubId).
  agentsHub            Utilisateur[]              @relation("UtilisateurHub")
  commandesActuelles   Commande[]                 @relation("CommandeHubActuel")
  historiqueReceptions HistoriqueStatutCommande[]
  // § /admin/bon-envoi : Bons d'Envoi dont ce hub est la destination.
  bonsEnvoiDestination BonEnvoi[]                 @relation("BonEnvoiHubDestination")
  // § /admin/bon-distribution : Bons de Distribution locaux à ce hub (le hub
  // lui-même sert de "zone" à l'étape 1 du wizard, cf. BonDistribution).
  bonsDistribution     BonDistribution[]          @relation("BonDistributionHub")
  // § Règlements et retours : le hub sert de "zone" au filtrage des bons de
  // paiement livreur et des bons de retour (§ /admin/bon-paiement/zone,
  // § /admin/bon-retour/zone).
  bonsPaiement         BonPaiement[]              @relation("BonPaiementHub")
  bonsRetour           BonRetour[]                @relation("BonRetourHub")

  // Clé naturelle d'une AGENCE : un prestataire n'a qu'un quai par ville-siège.
  // `nom` reste unique de son côté, mais c'est un libellé, pas une identité —
  // s'y fier pour retrouver une agence a permis à un import de réaffecter le
  // hub d'un prestataire à un autre, ses villes avec lui (§ resoudreAgence
  // dans lib/prestataires.ts). Les hubs internes ont `prestataireId` NULL et
  // ne sont donc pas contraints par cet index : plusieurs hubs internes dans
  // une même ville restent possibles, c'est voulu.
  @@unique([prestataireId, ville])
  @@index([prestataireId])
  @@map("hubs")
}

model Ville {
  id    String @id @default(uuid())
  nom   String
  hubId String @map("hub_id")
  hub   Hub    @relation(fields: [hubId], references: [id])

  tarifsLivreurs     TarifLivreurVille[]
  tarifsMarchands    TarifMarchandVille[]
  tarifsPrestataires TarifPrestataireVille[]
  commandes          Commande[]

  // Le nom était unique pour TOUT le réseau. C'était juste tant qu'un seul
  // transporteur existait : une ville n'appartenait qu'à un hub, le nom
  // l'identifiait donc sans ambiguïté.
  //
  // La sous-traitance a rendu cette contrainte fausse. Plusieurs prestataires
  // desservent les mêmes villes — EST Livraison et Meta Livraison annoncent
  // tous deux Taza, Aknoul, Tahla, Bouhlou — et chacun a SON prix et SON
  // délai. Sous l'ancienne règle, le second import se voyait refuser ces
  // villes : sa grille était donc amputée en silence, et l'écran ne reflétait
  // plus la couverture réelle de l'un des deux réseaux.
  //
  // L'unicité porte désormais sur (hub, nom) : chaque agence tient sa propre
  // liste, telle que son fournisseur l'a écrite, sans jamais empiéter sur
  // celle d'un concurrent. Deux lignes « Aknoul » coexistent, une par réseau.
  //
  // ⚠️ Conséquence à connaître : `getVilleHubIndex()` (lib/hub-envoi.ts) fait
  // correspondre une ville en texte libre à UN hub. Quand plusieurs réseaux
  // annoncent la même ville, ce choix devient commercial et non technique —
  // l'index applique une règle déterministe et documentée, faute d'arbitrage
  // explicite en base.
  @@unique([hubId, nom])
  @@index([hubId])
  @@index([nom])
  @@map("villes")
}

// Prestataire de livraison sous-traité (§ /admin/prestataires) — société
// externe (Power Delivery…) qui prend nos colis en charge sur un périmètre de
// villes, à son propre tarif. Ses points de dépôt physiques ne sont pas une
// nouvelle entité : ce sont des Hub dont `prestataireId` pointe ici, si bien
// que le référentiel géographique reste plat (Hub ↔ Ville) et que tout le
// circuit colis existant (réception au quai, transit inter-hubs, historique)
// fonctionne à l'identique sur une agence sous-traitée.
model Prestataire {
  id        String  @id @default(uuid())
  nom       String  @unique
  contact   String?
  telephone String?
  email     String?
  // Désactivé plutôt que supprimé : un prestataire dont on arrête le contrat
  // reste porteur de l'historique tarifaire des colis déjà livrés.
  actif     Boolean @default(true)

  // Compte HUMAIN du transporteur : un compte livreur de type `societe`
  // (§ TypeCompteLivreur) avec lequel il ouvre une session dans l'espace
  // terrain, voit les colis qu'on lui a confiés et en déclare l'issue à la
  // main. Pendant exact de `compteMachine` ci-dessous, pour les transporteurs
  // qui n'ont pas de système à brancher — et les deux peuvent coexister.
  //
  // OPTIONNEL, et c'est tout l'intérêt : un transporteur sans compte se
  // comporte exactement comme avant (bon d'envoi, puis fichier ou API). Le
  // rattachement n'ouvre pas un droit, il désigne un destinataire : c'est lui
  // qui fait poser `Commande.livreurId` à la création d'un bon d'envoi, donc
  // qui répond à « qui livre ce colis » dès la décision, et non après coup.
  compteLivreurId String?      @unique @map("compte_livreur_id")
  compteLivreur   Utilisateur? @relation("PrestataireCompteLivreur", fields: [compteLivreurId], references: [id])

  agences       Hub[]
  tarifs        TarifPrestataireVille[]
  // Compte machine du prestataire (§ PlateformePartenaire.prestataireId) —
  // absent tant qu'aucune clé d'API ne lui a été ouverte, ce qui est le cas
  // des transporteurs qui nous renvoient leurs statuts par fichier.
  compteMachine PlateformePartenaire?
  // Colis confiés par son API, et ce qu'il nous en a dit (§ Power Delivery).
  remises       RemisePrestataire[]
  // Bons d'envoi qui lui sont directement adressés (§ BonEnvoi.prestataireId) —
  // indépendants de ses agences : un bon peut lui être confié pour des villes
  // qu'aucune de ses agences ne déclare encore.
  bonsEnvoi     BonEnvoi[]
  evenements    EvenementPrestataire[]

  @@map("prestataires")
}

// Grille tarifaire d'ACHAT de la livraison sous-traitée — troisième grille du
// système, à côté de TarifLivreurVille (ce que nous devons au livreur interne)
// et TarifMarchandVille (ce que le marchand nous doit). Les trois coexistent
// et ne sont jamais dérivées l'une de l'autre, pour la même raison : la marge
// sur une ville sous-traitée EST la différence entre le tarif marchand et
// celui-ci, et la rendre implicite la rendrait impossible à piloter.
//
// Volontairement indexée sur (prestataire, ville) et non sur l'agence : un
// prestataire peut être tarifé sur une ville qu'il ne dessert pas encore
// (comparaison d'offres, bascule), tandis que Ville.hubId dit qui la couvre
// réellement aujourd'hui.
//
// tarifRetour est nullable parce que les grilles fournisseurs ne le donnent
// pas toujours — celle de Power Delivery n'a qu'une colonne livraison.
model TarifPrestataireVille {
  id             String      @id @default(uuid())
  prestataireId  String      @map("prestataire_id")
  prestataire    Prestataire @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  villeId        String      @map("ville_id")
  ville          Ville       @relation(fields: [villeId], references: [id], onDelete: Cascade)
  tarifLivraison Decimal     @map("tarif_livraison") @db.Decimal(10, 2)
  tarifRetour    Decimal?    @map("tarif_retour") @db.Decimal(10, 2)

  @@unique([prestataireId, villeId])
  @@index([villeId])
  @@map("tarifs_prestataire_ville")
}

// ============================================================
// Remise d'un colis à un prestataire PAR SON API (§ Power Delivery)
// ============================================================

// État de la REMISE elle-même — la relation avec le transporteur — et non du
// colis : Commande.statut reste la vérité métier, visible du marchand. Les deux
// avancent séparément : une remise `acceptee` porte un colis qui peut être
// livré, reporté ou en retour.
enum EtatRemisePrestataire {
  // Le prestataire a accepté le colis ; son suivi arrive par webhook.
  acceptee
  // L'appel a été refusé (ville inconnue d'eux, code en double, champ
  // invalide…). Rien n'existe chez eux : la remise n'est pas active, et le
  // colis peut être remis de nouveau une fois la cause corrigée.
  refusee
  // L'appel n'a pas répondu à temps : on ne sait PAS si le colis existe chez
  // eux. La remise reste active — un nouvel essai avec le même code se ferait
  // refuser comme doublon, ce qui prouverait qu'il existe — et c'est le suivi
  // (trackparcel) qui tranche vers `acceptee` ou `refusee`.
  a_confirmer
  // Retirée par nous : le colis n'est plus chez ce prestataire.
  annulee
}

// Un colis à nous, confié à un prestataire par son API. Remplace, pour les
// villes qui ont un identifiant chez lui, l'export Excel du Bon d'Envoi
// (GET /api/bons-envoi/[id]/export) — qui reste la voie des villes mises de
// côté (lib/power-delivery-villes.ts).
//
// Aucune colonne n'est ajoutée à `commandes` : toute la relation avec le
// transporteur vit ici, et abandonner l'intégration reviendrait à supprimer
// deux tables, jamais à défaire des colonnes sur la table la plus chaude du
// schéma (cf. API_PARTENAIRES.md §1.2).
//
// Une commande peut avoir PLUSIEURS remises au fil du temps (un refus puis un
// nouvel essai, un retour puis une seconde remise), d'où l'absence de
// @@unique([commandeId]). `active` est vraie sur UNE ligne au plus par
// commande : garantie par un index unique PARTIEL posé à la main dans la
// migration (… WHERE active), que Prisma ne sait pas écrire ici. Sans lui, deux
// clics simultanés sur « Remettre » confieraient deux fois le même colis.
model RemisePrestataire {
  id            String      @id @default(uuid())
  commandeId    String      @map("commande_id")
  commande      Commande    @relation(fields: [commandeId], references: [id])
  prestataireId String      @map("prestataire_id")
  prestataire   Prestataire @relation(fields: [prestataireId], references: [id])
  // Bon d'Envoi depuis lequel la remise a été faite — c'est lui qui porte
  // l'agence de destination, donc la ville à résoudre.
  bonEnvoiId    String?     @map("bon_envoi_id")
  bonEnvoi      BonEnvoi?   @relation(fields: [bonEnvoiId], references: [id])
  // Personne qui a déclenché la remise. Un statut reçu ensuite est signé du
  // compte de service du prestataire, pas d'elle (HistoriqueStatutCommande).
  remisParId    String      @map("remis_par_id")
  remisPar      Utilisateur @relation("RemisePrestataireAuteur", fields: [remisParId], references: [id])

  etat   EtatRemisePrestataire
  active Boolean               @default(true)

  // Code sous lequel NOUS avons déclaré le colis chez eux (`MTH-PD-000123`,
  // cf. PREFIXE_CODE_POWER, lib/power-delivery.ts). C'est lui que leurs
  // webhooks citent tant qu'ils n'attribuent pas leur propre code.
  codeEnvoye  String  @map("code_envoye")
  // Code attribué par LEUR système, s'il en attribue un — leur documentation
  // ne montre pas la réponse de création. Null tant qu'on ne l'a pas lu.
  codeExterne String? @map("code_externe")
  // Identifiant de ville envoyé (lib/power-delivery-villes.ts), figé : si la
  // correspondance change ensuite, ce qui a été envoyé ne change pas.
  cityId      Int     @map("city_id")

  // COD demandé au prestataire, FIGÉ à la remise (copie de Commande.montantCod
  // à cet instant). C'est ce qu'il doit nous reverser : si le marchand corrige
  // le montant ensuite, la dette du transporteur ne bouge pas rétroactivement.
  montantCodConfie Decimal @map("montant_cod_confie") @db.Decimal(10, 2)

  // Réponse BRUTE de leur API à la création, et erreur lisible en cas de refus.
  // Gardées telles quelles : quand un marchand conteste, il faut montrer ce que
  // le transporteur a réellement répondu, pas notre interprétation.
  reponseCreation Json?   @map("reponse_creation")
  erreur          String?

  // Dernier état reçu d'eux, tel quel, avant traduction — y compris les
  // statuts de leur logistique interne, qu'on ne pose jamais sur le colis
  // (lib/power-delivery-statuts.ts). `dernierPaiementExterne` (NOT_PAID, PAID,
  // INVOICED) dit s'ils nous ont reversé le COD ; il ne touche JAMAIS
  // Commande.etatPaiement, qui décrit notre règlement AU MARCHAND.
  dernierStatutExterne   String?   @map("dernier_statut_externe")
  dernierPaiementExterne String?   @map("dernier_paiement_externe")
  dernierEvenementLe     DateTime? @map("dernier_evenement_le")

  // Demandes soumises à leur équipe, qui les accepte ou les refuse de son côté.
  demandeRetourLe      DateTime? @map("demande_retour_le")
  demandeRelivraisonLe DateTime? @map("demande_relivraison_le")

  creeLe DateTime @default(now()) @map("cree_le")

  evenements EvenementPrestataire[]

  @@index([commandeId])
  @@index([prestataireId, etat])
  @@index([codeEnvoye])
  @@index([codeExterne])
  @@index([bonEnvoiId])
  @@map("remises_prestataire")
}

// Journal de CHAQUE information reçue d'un prestataire sur ses colis — webhook
// ou suivi — y compris celles qu'on a refusées ou ignorées.
//
// Il est indispensable, pas décoratif : leurs webhooks n'ont AUCUN identifiant
// d'événement, ne sont réessayés que trois fois et arrivent dans un ordre non
// garanti. Sans ce journal, « qu'ont-ils dit, et quand ? » n'a pas de réponse,
// et une signature invalide — tentative de falsification ou secret mal
// configuré — passerait inaperçue.
//
// ⚠️ `charge` contient des données personnelles (téléphone, adresse du
// destinataire) : à purger sur une fenêtre glissante, comme JournalAppelApi.
model EvenementPrestataire {
  id            String             @id @default(uuid())
  prestataireId String             @map("prestataire_id")
  prestataire   Prestataire        @relation(fields: [prestataireId], references: [id])
  // Null quand aucun colis confié ne correspond au code reçu.
  remiseId      String?            @map("remise_id")
  remise        RemisePrestataire? @relation(fields: [remiseId], references: [id])

  // 'webhook' | 'suivi' — texte plutôt qu'enum : une source nouvelle (import
  // Excel de retour, par exemple) ne doit pas exiger de migration.
  source String

  codeColis       String? @map("code_colis")
  statutExterne   String? @map("statut_externe")
  statutSecond    String? @map("statut_second")
  paiementExterne String? @map("paiement_externe")

  // Corps reçu, tel quel.
  charge          Json
  // Null pour un suivi (appel sortant, rien à vérifier).
  signatureValide Boolean? @map("signature_valide")

  // Ce qui a été fait, et pourquoi : applique, inchange, memorise, inconnu,
  // refuse, colis_introuvable, signature_invalide, perime. Texte pour la même
  // raison que `source`.
  issue  String
  detail String?

  recuLe DateTime @default(now()) @map("recu_le")

  @@index([prestataireId, recuLe])
  @@index([remiseId])
  @@map("evenements_prestataire")
}

// Surcharge des frais de livraison/refus d'un livreur pour une ville donnée
// (maquette "Ajouter Utilisateur" : Frais de livraison (Agadir), etc.) —
// distincte des frais par défaut Utilisateur.fraisLivraison/fraisRefus, qui
// restent le tarif appliqué pour toute ville sans ligne ici.
model TarifLivreurVille {
  id             String      @id @default(uuid())
  utilisateurId  String      @map("utilisateur_id")
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id])
  villeId        String      @map("ville_id")
  ville          Ville       @relation(fields: [villeId], references: [id])
  fraisLivraison Decimal     @map("frais_livraison") @db.Decimal(10, 2)
  fraisRefus     Decimal     @map("frais_refus") @db.Decimal(10, 2)

  @@unique([utilisateurId, villeId])
  @@index([villeId])
  @@map("tarifs_livreur_ville")
}

// ============================================================
// Tableau Kanban interne (§ /admin/tasks)
// ============================================================

// Pôle interne (Développement, Administration, Gestionnaires/Hub…) — table
// plutôt qu'un enum pour permettre d'en ajouter sans migration. Aucun pôle
// n'est seedé : ils se créent depuis /admin/tasks (POST /api/taches/equipes,
// réservé à l'admin), donc une base fraîche démarre sans aucune équipe.
model EquipeTache {
  id      String @id @default(uuid())
  code    String @unique
  nom     String
  // Clé de couleur (ex. "blue", "violet", "emerald") consommée côté UI pour
  // le tag d'équipe des cartes — pas de valeur CSS brute en base.
  couleur String @default("gray")

  taches  Tache[]
  membres EquipeTacheMembre[]

  @@map("equipes_taches")
}

// Rattachement d'un compte back-office à un pôle (§ /admin/tasks, gestion
// d'équipe) : pilote le multi-select "membres" à l'édition d'une équipe et
// restreint la liste "Assigné" du Kanban aux membres du pôle sélectionné.
// Un même utilisateur peut appartenir à plusieurs pôles.
model EquipeTacheMembre {
  id            String      @id @default(uuid())
  equipeId      String      @map("equipe_id")
  equipe        EquipeTache @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  utilisateurId String      @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  dateAjout     DateTime    @default(now()) @map("date_ajout")

  @@unique([equipeId, utilisateurId])
  @@index([equipeId])
  @@index([utilisateurId])
  @@map("equipes_taches_membres")
}

// Étiquettes de tâche (§ /admin/tasks) : liste tenue en base et modifiable
// depuis le tableau, plutôt qu'une énumération figée dans le code — ajouter un
// thème ne demande plus un déploiement.
//
// Tache.etiquettes stocke des `code`, pas des libellés : renommer une
// étiquette n'oblige pas à réécrire les tâches qui la portent. La suppression
// d'une étiquette retire son code des tâches dans la même transaction (cf.
// DELETE /api/taches/etiquettes/[id]), sinon les tableaux garderaient des
// codes fantômes qu'aucune couleur ne saurait peindre.
model EtiquetteTache {
  id String @id @default(uuid())
  // Identifiant lisible et stable, dérivé du nom à la création.
  code String @unique
  nom  String
  // Clé de la palette de chips (design, frontend, backend, research, bug,
  // docs) consommée côté UI — jamais une valeur CSS brute, même convention
  // qu'EquipeTache.couleur.
  couleur      String   @default("docs")
  dateCreation DateTime @default(now()) @map("date_creation")

  @@map("etiquettes_taches")
}

model Tache {
  id           String        @id @default(uuid())
  numero       Int           @unique @default(autoincrement())
  titre        String
  description  String?
  statut       StatutTache   @default(a_faire)
  priorite     PrioriteTache @default(moyenne)
  progress     Int           @default(0)
  etiquettes   String[]      @default([])
  teamId       String        @map("team_id")
  team         EquipeTache   @relation(fields: [teamId], references: [id])
  assigneeId   String?       @map("assignee_id")
  assignee     Utilisateur?  @relation("TacheAssignee", fields: [assigneeId], references: [id])
  createurId   String        @map("createur_id")
  createur     Utilisateur   @relation("TacheCreateur", fields: [createurId], references: [id])
  dateEcheance DateTime?     @map("date_echeance") @db.Date
  dateCreation DateTime      @default(now()) @map("date_creation")

  // Marquage de blocage (§ /admin/tasks) : signalé par un indicateur "Bloqué"
  // avec raison explicite quand la tâche ne peut plus avancer.
  bloque        Boolean @default(false)
  raisonBlocage String? @map("raison_blocage")

  commentaires      CommentaireTache[]
  historiqueStatuts HistoriqueStatutTache[]
  piecesJointes     PieceJointeTache[]

  @@index([teamId])
  @@index([assigneeId])
  @@index([statut])
  @@map("taches")
}

// Historise chaque changement de statut (§ traçabilité /admin/tasks), même
// principe qu'HistoriqueStatutCommande : le temps passé dans chaque colonne
// se déduit en diffant les horodatages consécutifs plutôt que de stocker des
// bornes début/fin redondantes.
model HistoriqueStatutTache {
  id            String       @id @default(uuid())
  tacheId       String       @map("tache_id")
  tache         Tache        @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  ancienStatut  StatutTache? @map("ancien_statut")
  nouveauStatut StatutTache  @map("nouveau_statut")
  utilisateurId String       @map("utilisateur_id")
  utilisateur   Utilisateur  @relation("HistoriqueStatutTacheAuteur", fields: [utilisateurId], references: [id])
  horodatage    DateTime     @default(now())

  @@index([tacheId])
  @@map("historique_statuts_tache")
}

// Pièces jointes d'une tâche (§ /admin/tasks).
//
// `url` porte DEUX choses, et il faut le savoir avant d'écrire une requête
// dessus :
//   - un lien externe (« https://… »), ou
//   - un fichier déposé, encodé en entier dans une data URL
//     (« data:<mime>;base64,… »).
// Même convention que Utilisateur.photoUrl : le projet n'a pas d'infra de
// stockage de fichiers, et en monter une pour un tableau interne coûterait
// plus cher que la place prise en base. Le plafond de 3 Mo posé dans
// lib/pieces-jointes.ts (avec la liste blanche des formats acceptés) est ce
// qui rend le choix tenable.
//
// CONSÉQUENCE : ne jamais sélectionner `url` pour dresser une liste. Un
// findMany naïf rapatrierait plusieurs mégaoctets de base64 par tâche — c'est
// la raison d'être de `piecesJointesExposees` (lib/taches-pieces-jointes.ts),
// qui n'en lit que l'en-tête, et de la route de contenu qui sert l'octet à la
// demande.
model PieceJointeTache {
  id        String      @id @default(uuid())
  tacheId   String      @map("tache_id")
  tache     Tache       @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  nom       String
  url       String
  auteurId  String      @map("auteur_id")
  auteur    Utilisateur @relation("PieceJointeTacheAuteur", fields: [auteurId], references: [id])
  dateAjout DateTime    @default(now()) @map("date_ajout")

  @@index([tacheId])
  @@map("pieces_jointes_tache")
}

// Fil de discussion d'une tâche. mentionIds : identifiants des utilisateurs
// tagués via "@" dans le texte (résolus/surlignés côté UI, pas de notification).
model CommentaireTache {
  id           String      @id @default(uuid())
  tacheId      String      @map("tache_id")
  tache        Tache       @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  auteurId     String      @map("auteur_id")
  auteur       Utilisateur @relation(fields: [auteurId], references: [id])
  texte        String
  mentionIds   String[]    @map("mention_ids")
  dateCreation DateTime    @default(now()) @map("date_creation")

  @@index([tacheId])
  @@map("commentaires_tache")
}

// ============================================================
// Comptabilité (§ /admin/comptabilite)
// ============================================================

// Écriture comptable unique (revenu ou dépense) — accès restreint à
// admin/responsable (cf. requireUser dans app/api/finance/**). Montant
// toujours positif ; le signe affiché côté UI dépend uniquement de `type`.
// Immuable une fois créée : pas de PATCH/DELETE, seule une transaction de
// compensation (annulation) peut neutraliser une écriture — cf. estAnnulee /
// transactionOrigineId, qui portent la traçabilité d'audit plutôt qu'une
// suppression physique.
model Transaction {
  id          String               @id @default(uuid())
  montant     Decimal              @db.Decimal(10, 2)
  type        TypeTransaction
  categorie   CategorieTransaction
  dateEffet   DateTime             @map("date_effet")
  description String?

  // Justificatif photo de l'écriture (reçu, bordereau de versement, capture
  // d'un virement) — FACULTATIF, et ce n'est pas un oubli. La pièce papier
  // n'est presque jamais sous la main au moment où l'écriture est saisie :
  // l'exiger ferait remettre la saisie à plus tard, c'est-à-dire à jamais, et
  // un journal incomplet coûte plus cher qu'un justificatif manquant. Une
  // preuve absente vaut `null`, jamais une chaîne vide.
  //
  // Stockée en data URL (« data:<mime>;base64,… »), même convention que les
  // preuves de livraison (Commande.photoPreuveUrl) et les pièces jointes de
  // tâche : ce projet n'a pas d'infrastructure de stockage objet. Le plafond
  // de poids et la liste blanche de formats vivent dans lib/finance.ts
  // (analyserPreuveTransaction) ; le SVG en est écarté, servi depuis notre
  // origine il s'exécuterait avec le cookie de session du comptable.
  //
  // CONSÉQUENCE : ne JAMAIS sélectionner cette colonne pour dresser le
  // journal. Un findMany naïf rapatrierait le base64 de chaque écriture à
  // chaque ouverture de /admin/comptabilite — d'où le `omit` de
  // GET /api/finance, qui n'expose qu'un pointeur vers la route de contenu
  // (GET /api/finance/[id]/preuve), laquelle sert l'octet à la demande.
  preuveUrl   String?              @map("preuve_url")

  auteurId String      @map("auteur_id")
  auteur   Utilisateur @relation("TransactionAuteur", fields: [auteurId], references: [id])

  // Une écriture annulée reste en base (audit) et gagne un lien vers sa
  // transaction de compensation (montant/type inversés, même catégorie).
  estAnnulee           Boolean      @default(false) @map("est_annulee")
  transactionOrigineId String?      @unique @map("transaction_origine_id")
  transactionOrigine   Transaction? @relation("Annulation", fields: [transactionOrigineId], references: [id])
  annulation           Transaction? @relation("Annulation")

  // Remise de caisse d'une tournée (§ clôture de tournée) : l'écriture est
  // générée automatiquement, ce lien permet de remonter du journal comptable
  // au Bon de Distribution qui l'a produite.
  bonDistribution BonDistribution? @relation("TransactionRemiseTournee")

  // Sorties de caisse générées automatiquement par les deux circuits de
  // règlement (§ /admin/factures, § /admin/bon-paiement) — même principe que
  // la remise de tournée ci-dessus : le journal comptable reste la source de
  // vérité, ces liens permettent de remonter au document qui l'a produit.
  factureReglee Facture?     @relation("TransactionReglementMarchand")
  bonPaiement   BonPaiement? @relation("TransactionReglementLivreur")

  dateCreation DateTime @default(now()) @map("date_creation")

  @@index([type])
  @@index([categorie])
  @@index([dateEffet])
  @@map("transactions")
}

// ============================================================
// Commandes de stock des hubs (équipement, consommables)
// ============================================================

// Cycle de vie d'une commande de matériel/équipement passée pour le
// fonctionnement d'un hub (rayonnage, consommables d'emballage...) — distinct
// de Produit.statutReception qui suit le stock des marchands.
//
//   brouillon — saisie, pas encore passée au fournisseur. Statut par défaut.
//   commandee — passée au fournisseur, pas encore livrée.
//   recue     — livrée au hub. Définitif.
//   annulee   — abandonnée, depuis brouillon ou commandee. Définitif.
//
// Les transitions autorisées vivent dans lib/commandes-stock-hub.ts
// (TRANSITIONS_COMMANDE_STOCK_HUB) : Prisma ne sait pas les exprimer.
//
// Jusqu'au 11/09/2026 l'enum valait en_attente / livre / annulee. Les deux
// premières ont été RENOMMÉES (commandee, recue) plutôt que recréées, et les
// commandes existantes ont gardé leur sens sans réécriture (migration
// 20260911150000). NE PAS RÉORDONNER les valeurs ci-dessous : c'est l'ordre
// réel en base, et PostgreSQL ne sait pas déplacer une valeur d'enum.
enum StatutCommandeStockHub {
  brouillon
  commandee
  recue
  annulee
}

// § Comptabilité (/admin/comptabilite, carte "Commandes d'inventaire") : même
// périmètre d'accès que Transaction (admin/responsable, cf. requireUser dans
// app/api/commandes-stock-hub/**). `numero` sert de référence bordereau
// lisible (BC-{numero}) sans dépendre de l'UUID.
//
// Aucune écriture comptable n'y est rattachée : ni la création ni un
// changement de statut (annulation comprise) ne crée ou ne compense de
// Transaction. Le montant est informatif.
model CommandeStockHub {
  id           String                 @id @default(uuid())
  numero       Int                    @unique @default(autoincrement())
  titre        String
  sousTitre    String?                @map("sous_titre")
  montant      Decimal                @db.Decimal(10, 2)
  statut       StatutCommandeStockHub @default(brouillon)
  modePaiement String                 @map("mode_paiement")
  dateCommande DateTime               @map("date_commande")

  // Justificatif photo de la commande (facture du fournisseur, bon de
  // livraison signé, reçu de virement) — FACULTATIF, exactement comme
  // Transaction.preuveUrl : voir ce champ pour la règle complète, la convention
  // de stockage en data URL et la liste blanche de formats (lib/finance.ts,
  // analyserPreuveComptable, partagée entre les deux cartes de
  // /admin/comptabilite).
  //
  // CONSÉQUENCE, identique : ne JAMAIS sélectionner cette colonne pour dresser
  // la liste des commandes. GET /api/commandes-stock-hub l'écarte par `omit` et
  // n'expose qu'un pointeur vers sa route de contenu.
  preuveUrl    String?                @map("preuve_url")

  auteurId String      @map("auteur_id")
  auteur   Utilisateur @relation("CommandeStockHubAuteur", fields: [auteurId], references: [id])

  dateCreation DateTime @default(now()) @map("date_creation")

  @@index([statut])
  @@map("commandes_stock_hub")
}

// ============================================================
// Facturation marchand (§ /admin/factures)
// ============================================================

// Grille tarifaire FACTURÉE AU MARCHAND — pendant exact de TarifLivreurVille
// (§ Zonage logistique), mais de l'autre côté du bilan : celle-ci dit ce que
// le marchand nous doit, celle-là ce que nous devons au livreur. Les deux
// coexistent volontairement et ne sont jamais dérivées l'une de l'autre — la
// marge de la plateforme sur une ville EST la différence entre les deux, et
// la rendre implicite la rendrait impossible à piloter.
//
// Repli quand aucune ligne n'existe pour la ville livrée :
// Marchand.fraisLivraison / Marchand.fraisRetour, eux-mêmes à 0 s'ils n'ont
// jamais été renseignés (même convention que le livreur, cf. getTarifsLivreur
// dans lib/bon-distribution.ts).
model TarifMarchandVille {
  id             String   @id @default(uuid())
  marchandId     String   @map("marchand_id")
  marchand       Marchand @relation(fields: [marchandId], references: [id], onDelete: Cascade)
  villeId        String   @map("ville_id")
  ville          Ville    @relation(fields: [villeId], references: [id])
  fraisLivraison Decimal  @map("frais_livraison") @db.Decimal(10, 2)
  fraisRetour    Decimal  @map("frais_retour") @db.Decimal(10, 2)

  @@unique([marchandId, villeId])
  @@index([villeId])
  @@map("tarifs_marchand_ville")
}

// Machine à états de la facture marchand — quatre temps, strictement calqués
// sur ceux de la paie livreur (cf. StatutBonPaiement) parce que c'est le même
// circuit comptable vu de l'autre côté du bilan :
//   brouillon — la sélection de colis est faite et les colis sont RÉSERVÉS,
//               mais tout reste modifiable : on peut retirer un colis,
//               ajouter des frais annexes, changer d'avis. Rien n'a encore
//               été annoncé au marchand.
//   emise     — arrêtée : les montants sont figés, le document devient
//               visible dans l'espace marchand et vaut créance.
//   payee     — l'argent est sorti (virement/espèces/chèque). C'est CE
//               statut, et lui seul, qui répond à « ce marchand a-t-il été
//               reversé ? ».
//   annulee   — erreur d'émission ou contestation : les lignes sont
//               supprimées et les colis redeviennent facturables. On
//               n'efface jamais la facture elle-même, on la neutralise —
//               même principe que Transaction.estAnnulee.
enum StatutFacture {
  brouillon
  emise
  payee
  annulee
}

// Moyen effectif du reversement, saisi au passage `payee` — avec sa référence
// (n° de virement, n° de chèque). Sans ces deux champs, « payée » est une
// affirmation invérifiable le jour d'une contestation.
//
// Énumération distincte de ModeReglementLivreur bien que les trois valeurs
// coïncident aujourd'hui : les deux flux sont indépendants (l'un facture des
// frais, l'autre verse un salaire) et rien ne garantit qu'ils évolueront
// ensemble — les fusionner créerait un couplage que le modèle refuse déjà
// entre les deux grilles tarifaires.
enum ModeReglementMarchand {
  virement
  especes
  cheque
}

// Document de règlement du MARCHAND (§ /admin/factures) : ce que la
// plateforme lui doit sur une sélection de colis clos. C'est le pendant du
// Bon de Paiement (qui règle le livreur), et c'est lui qui fait avancer
// Commande.etatPaiement — non_paye → facture à l'émission, → paye au
// règlement (cf. l'enum EtatPaiement, prévu dès l'origine pour ce circuit).
//
// Les totaux sont recalculés tant que la facture est BROUILLON, puis FIGÉS à
// l'émission et plus jamais retouchés : la grille tarifaire peut changer le
// lendemain, une facture déjà émise ne doit pas bouger. Le détail ligne à
// ligne vit dans LigneFacture pour que la vue d'impression soit reproductible
// à l'identique des années plus tard.
model Facture {
  id         String        @id @default(uuid())
  numero     String        @unique
  marchandId String        @map("marchand_id")
  marchand   Marchand      @relation(fields: [marchandId], references: [id])
  statut     StatutFacture @default(brouillon)

  nbColisLivres       Int     @map("nb_colis_livres")
  nbColisRetournes    Int     @map("nb_colis_retournes")
  // Somme des COD des colis LIVRÉS uniquement : un colis retourné n'a rien
  // encaissé, il ne pèse sur la facture que par ses frais de retour.
  totalCod            Decimal @map("total_cod") @db.Decimal(12, 2)
  totalFraisLivraison Decimal @map("total_frais_livraison") @db.Decimal(12, 2)
  totalFraisRetour    Decimal @map("total_frais_retour") @db.Decimal(12, 2)
  // Somme des frais annexes saisis à la main (emballage, réexpédition,
  // service dédié…), toujours POSITIVE : ils se retranchent du net comme les
  // frais de livraison. Recalculée à chaque ajout/retrait de ligne tant que
  // la facture est `brouillon`. Pendant de BonPaiement.totalAjustements, à
  // ceci près qu'un frais ne peut pas être une prime — il n'y a pas de
  // contrepartie positive à reverser au marchand hors du COD.
  totalAutresFrais    Decimal @default(0) @map("total_autres_frais") @db.Decimal(12, 2)
  // totalCod - totalFraisLivraison - totalFraisRetour - totalAutresFrais.
  // Peut être négatif (beaucoup de retours, peu de livraisons) : c'est alors
  // le marchand qui doit à la plateforme, et le signe doit rester lisible
  // tel quel.
  netAPayer           Decimal @map("net_a_payer") @db.Decimal(12, 2)

  // § Marge — somme des LigneFacture.coutLivraison CONNUS, et nombre de lignes
  // dont le coût ne l'est pas. INTERNES tous les deux, retirés des réponses
  // servies à un marchand (cf. LigneFacture.coutLivraison).
  //
  // La marge elle-même n'est pas stockée : c'est
  //   totalFraisLivraison + totalFraisRetour + totalAutresFrais − totalCoutLivraison
  // (cf. margeFacture, lib/facturation.ts). Le COD n'y entre pas — il transite
  // par nos comptes mais appartient au marchand, l'inclure ferait passer pour
  // du bénéfice l'argent de quelqu'un d'autre.
  //
  // `nbLignesCoutInconnu` accompagne toujours le total : sans lui, une facture
  // dont la moitié des coûts manquent afficherait une marge flatteuse et
  // fausse, indiscernable d'une vraie.
  totalCoutLivraison  Decimal @default(0) @map("total_cout_livraison") @db.Decimal(12, 2)
  nbLignesCoutInconnu Int     @default(0) @map("nb_lignes_cout_inconnu")

  // Quatre dates distinctes plutôt qu'une : elles mesurent le délai de
  // reversement aux marchands, qui est l'engagement commercial le plus scruté
  // d'une plateforme COD.
  //
  // `dateEmission` est la date de CRÉATION du document, brouillon compris —
  // conservée sous ce nom parce que les factures antérieures au brouillon
  // l'utilisent déjà comme telle ; `dateValidation` marque le passage
  // brouillon → emise, c'est-à-dire l'instant où les montants ont été figés.
  dateEmission   DateTime  @default(now()) @map("date_emission")
  dateValidation DateTime? @map("date_validation")
  datePaiement   DateTime? @map("date_paiement")
  dateAnnulation DateTime? @map("date_annulation")

  // Pourquoi la facture a été retirée : « colis livré par erreur », « accord
  // commercial »… Une facture annulée sans motif est un trou dans la piste
  // d'audit qu'on ne peut plus combler après coup.
  motifAnnulation String? @map("motif_annulation")

  modeReglement      ModeReglementMarchand? @map("mode_reglement")
  referenceReglement String?                @map("reference_reglement")

  emiseParId String      @map("emise_par_id")
  emisePar   Utilisateur @relation("FactureEmetteur", fields: [emiseParId], references: [id])

  valideParId String?      @map("valide_par_id")
  validePar   Utilisateur? @relation("FactureValidateur", fields: [valideParId], references: [id])

  // Écriture comptable de sortie de caisse générée au règlement (§
  // /admin/comptabilite) — 1-1, comme la remise de caisse d'une tournée.
  transactionId String?      @unique @map("transaction_id")
  transaction   Transaction? @relation("TransactionReglementMarchand", fields: [transactionId], references: [id])

  lignes       LigneFacture[]
  fraisAnnexes FraisFacture[]

  @@index([marchandId])
  @@index([statut])
  @@map("factures")
}

// Frais annexe saisi à la main sur une facture en BROUILLON (§ /admin/factures) :
// emballage, réexpédition, service dédié. Une ligne plutôt qu'un simple champ
// « autres frais » sur la facture : le marchand qui conteste son net doit
// pouvoir lire POURQUOI il diffère de la somme de ses colis, et le comptable
// doit pouvoir en retirer un seul.
//
// Pendant d'AjustementBonPaiement, sans le champ `type` : un frais est
// toujours à la charge du marchand, il n'existe pas de contrepartie positive.
model FraisFacture {
  id        String  @id @default(uuid())
  factureId String  @map("facture_id")
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  libelle   String
  montant   Decimal @db.Decimal(10, 2)

  creeParId String      @map("cree_par_id")
  creePar   Utilisateur @relation("FraisFactureAuteur", fields: [creeParId], references: [id])

  dateCreation DateTime @default(now()) @map("date_creation")

  @@index([factureId])
  @@map("frais_facture")
}

// D'où vient le coût figé sur une ligne de facture — sans lui, un montant seul
// ne dirait pas s'il est certain (figé à la clôture d'une tournée) ou lu dans
// une grille fournisseur qui peut avoir bougé depuis.
enum SourceCoutLivraison {
  // Commande.fraisLivreur, figé colis par colis à la clôture de la tournée :
  // c'est le montant réellement dû au livreur, il fait foi.
  livreur
  // Grille du prestataire qui exploite le hub couvrant la ville
  // (TarifPrestataireVille), lue à l'émission de la facture.
  prestataire
}

// Une ligne = un colis facturé, avec le tarif RÉELLEMENT appliqué au moment
// de l'émission. `commandeId` est unique : un colis ne peut appartenir qu'à
// une seule facture, garanti par la base et non par la seule discipline des
// routes — c'est la protection anti-double-facturation.
model LigneFacture {
  id         String   @id @default(uuid())
  factureId  String   @map("facture_id")
  facture    Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  commandeId String   @unique @map("commande_id")
  commande   Commande @relation(fields: [commandeId], references: [id])
  // Vrai pour un colis livré (COD encaissé, frais de livraison), faux pour un
  // colis retourné (aucun COD, frais de retour). Stocké plutôt que redéduit
  // du statut du colis : celui-ci peut encore évoluer après facturation.
  livre      Boolean
  montantCod Decimal  @map("montant_cod") @db.Decimal(10, 2)
  frais      Decimal  @db.Decimal(10, 2)

  // § Marge — ce que la course nous a COÛTÉ, figé au même instant que `frais`
  // (ce qu'elle nous rapporte). Les deux côtés du même colis sur la même
  // ligne : c'est le seul endroit où la marge se lit sans rapprochement.
  //
  // INTERNE. Ces deux colonnes ne sortent JAMAIS vers un marchand — ni sur sa
  // facture, ni dans sa liste (elles sont retirées par `omit` côté requête,
  // cf. getFacture / GET /api/factures). Lui montrer notre prix d'achat, c'est
  // lui donner notre marge à la négociation suivante.
  //
  // Null = coût inconnu, jamais 0 : une tournée clôturée avant l'introduction
  // de Commande.fraisLivreur, une ville sous-traitée sans tarif convenu, ou un
  // retour chez un prestataire dont le tarif de retour n'est pas renseigné.
  // Zéro dirait « gratuit » et gonflerait la marge d'un montant inventé ;
  // c'est pour ça que Facture.nbLignesCoutInconnu existe.
  coutLivraison Decimal?             @map("cout_livraison") @db.Decimal(10, 2)
  coutSource    SourceCoutLivraison? @map("cout_source")

  @@index([factureId])
  @@map("lignes_facture")
}

// ============================================================
// Bon de paiement livreur (§ /admin/bon-paiement)
// ============================================================

// Machine à états de la paie livreur — quatre temps, calqués sur le circuit
// RH/comptabilité réel :
//   brouillon — le bon vient d'être généré pour le mois écoulé. Le décompte
//               des commissions est déjà figé, mais le comptable peut encore
//               y ajouter des ajustements (prime, pénalité pour perte).
//   valide    — arrêté par le responsable : plus aucun ajustement possible,
//               le montant est prêt à être décaissé.
//   paye      — l'argent est sorti (virement/espèces/chèque). C'est CE
//               statut, et lui seul, qui répond à « ce livreur est-il payé
//               pour août ? ».
//   annule    — erreur de saisie ou contestation : les tournées rattachées
//               sont libérées et redeviennent éligibles à un nouveau bon.
//               Un bon déjà `paye` ne s'annule PAS ici (cf. POST
//               /api/bons-paiement/[id]/annuler) — même règle que la facture
//               marchand : on neutralise par une écriture de compensation,
//               on n'efface pas un mouvement d'argent.
enum StatutBonPaiement {
  brouillon
  valide
  paye
  annule
}

// Moyen effectif du décaissement, saisi au passage `paye` — avec sa
// référence (n° de virement, n° de chèque). Sans ces deux champs, « payé »
// est une affirmation invérifiable le jour d'une contestation.
enum ModeReglementLivreur {
  virement
  especes
  cheque
}

enum TypeAjustementPaiement {
  prime
  penalite
}

// Règlement du LIVREUR (§ /admin/bon-paiement/livreur et /zone) : regroupe
// ses tournées clôturées d'une PÉRIODE DE PAIE mensuelle dont le gain n'a pas
// encore été payé (BonDistribution.gainLivreur non nul, bonPaiementId nul).
//
// Le montant des commissions n'est JAMAIS recalculé ici : il est la somme des
// gainLivreur figés à la clôture de chaque tournée (cf. le volet B du
// commentaire de POST /api/bons-distribution/[id]/cloturer). Une grille
// tarifaire modifiée après coup ne doit pas changer ce qui a déjà été gagné.
// Les ajustements (primes, pénalités) sont la SEULE façon de faire bouger le
// montant après génération, et ils restent tracés ligne à ligne.
//
// Les deux pages de la navigation ne sont que deux entrées de SÉLECTION vers
// le même document : "pour livreur" part d'un livreur, "pour zone" liste
// d'abord les livreurs d'un hub. Un bon reste toujours nominatif — on paie
// une personne, pas une zone.
model BonPaiement {
  id        String            @id @default(uuid())
  numero    String            @unique
  livreurId String            @map("livreur_id")
  livreur   Utilisateur       @relation("BonPaiementLivreur", fields: [livreurId], references: [id])
  // Hub de rattachement du livreur au moment de l'émission — figé ici pour
  // que le filtre "par zone" reste juste même si le livreur change de hub.
  hubId     String?           @map("hub_id")
  hub       Hub?              @relation("BonPaiementHub", fields: [hubId], references: [id])
  statut    StatutBonPaiement @default(brouillon)

  // Période de paie couverte, bornes incluses (1er → dernier jour du mois).
  // Stockée plutôt que déduite de dateGeneration : un bon généré en retard le
  // 12 septembre couvre toujours août, et c'est la période — pas la date de
  // génération — qui répond à « ce livreur est-il payé pour août ? ».
  periodeDebut DateTime @map("periode_debut")
  periodeFin   DateTime @map("periode_fin")

  nbTournees         Int     @map("nb_tournees")
  nbColisLivres      Int     @map("nb_colis_livres")
  nbColisRetournes   Int     @map("nb_colis_retournes")
  // Somme des gains de tournée, figée à la génération.
  montantCommissions Decimal @map("montant_commissions") @db.Decimal(12, 2)
  // Somme signée des ajustements (+ primes, − pénalités), recalculée à chaque
  // ajout/retrait de ligne tant que le bon est `brouillon`.
  totalAjustements   Decimal @default(0) @map("total_ajustements") @db.Decimal(12, 2)
  // montantCommissions + totalAjustements — le net réellement versé, et le
  // seul montant que reprend l'écriture comptable.
  montantTotal       Decimal @map("montant_total") @db.Decimal(12, 2)

  // Quatre dates distinctes plutôt qu'une : elles mesurent le délai de
  // paiement des livreurs, qui est un sujet social autant que comptable.
  dateGeneration DateTime  @default(now()) @map("date_generation")
  dateValidation DateTime? @map("date_validation")
  dateReglement  DateTime? @map("date_reglement")
  dateAnnulation DateTime? @map("date_annulation")

  motifAnnulation String? @map("motif_annulation")

  modeReglement      ModeReglementLivreur? @map("mode_reglement")
  referenceReglement String?               @map("reference_reglement")

  emisParId String      @map("emis_par_id")
  emisPar   Utilisateur @relation("BonPaiementEmetteur", fields: [emisParId], references: [id])

  valideParId String?      @map("valide_par_id")
  validePar   Utilisateur? @relation("BonPaiementValidateur", fields: [valideParId], references: [id])

  transactionId String?      @unique @map("transaction_id")
  transaction   Transaction? @relation("TransactionReglementLivreur", fields: [transactionId], references: [id])

  tournees    BonDistribution[]
  ajustements AjustementBonPaiement[]

  @@index([livreurId])
  @@index([hubId])
  @@index([statut])
  @@index([periodeDebut])
  @@map("bons_paiement")
}

// Prime ou pénalité ajoutée à la main sur un bon en BROUILLON (§ /admin/
// bon-paiement). Une ligne plutôt qu'un simple champ « ajustement » sur le
// bon : le livreur qui signe doit pouvoir lire POURQUOI son net diffère de la
// somme de ses tournées, et le comptable doit pouvoir en retirer une seule.
//
// `montant` est toujours POSITIF ; c'est `type` qui porte le signe. Stocker
// un montant signé rendrait un « −150 » de type prime silencieusement
// possible, et la fiche de paie illisible.
model AjustementBonPaiement {
  id            String                 @id @default(uuid())
  bonPaiementId String                 @map("bon_paiement_id")
  bonPaiement   BonPaiement            @relation(fields: [bonPaiementId], references: [id], onDelete: Cascade)
  type          TypeAjustementPaiement
  libelle       String
  montant       Decimal                @db.Decimal(10, 2)

  creeParId String      @map("cree_par_id")
  creePar   Utilisateur @relation("AjustementPaiementAuteur", fields: [creeParId], references: [id])

  dateCreation DateTime @default(now()) @map("date_creation")

  @@index([bonPaiementId])
  @@map("ajustements_bon_paiement")
}

// ============================================================
// Bon de retour marchand (§ /admin/bon-retour, § /ramasseur)
// ============================================================

// Circuit en trois temps, calqué sur le terrain :
//   nouveau  — le Planner compose le bon au hub (scan du QR ou ajout manuel).
//              Les colis y sont réservés mais restent physiquement au hub.
//   en_cours — un ramasseur est affecté et part rendre les colis au marchand.
//   remis    — le marchand a signé la décharge ; le bon est clos.
enum StatutBonRetour {
  nouveau
  en_cours
  remis
}

// Restitution physique des colis non livrés à leur marchand. Un bon = UN
// marchand : le marchand n'est jamais choisi dans un menu, il se déduit du
// premier colis scanné et les colis d'un autre marchand sont refusés à
// l'ajout — c'est ce qui rend la composition possible au scan, sans saisie.
// Même règle de groupement que BonDePreparation (§ Gestion de stock).
//
// La progression colis par colis ne se stocke pas ici : un colis du bon
// encore différent de `retourne` est un colis que le ramasseur n'a pas
// encore remis. Même mécanique que la clôture de tournée, qui déduit les
// colis restants de leur statut plutôt que d'un compteur parallèle.
model BonRetour {
  id         String          @id @default(uuid())
  numero     String          @unique
  marchandId String          @map("marchand_id")
  marchand   Marchand        @relation(fields: [marchandId], references: [id])
  // Hub d'où partent les colis — sert de filtre "pour zone" et cadre le
  // périmètre du Planner, qui ne compose que pour son propre hub.
  hubId      String?         @map("hub_id")
  hub        Hub?            @relation("BonRetourHub", fields: [hubId], references: [id])
  statut     StatutBonRetour @default(nouveau)

  nbColis         Int     @map("nb_colis")
  montantTotalCod Decimal @map("montant_total_cod") @db.Decimal(12, 2)

  dateGeneration DateTime    @default(now()) @map("date_generation")
  creeParId      String      @map("cree_par_id")
  creePar        Utilisateur @relation("BonRetourCreateur", fields: [creeParId], references: [id])

  // Ramasseur chargé de rapporter les colis au marchand. Nullable tant que le
  // bon n'est pas affecté (statut `nouveau`).
  ramasseurId     String?      @map("ramasseur_id")
  ramasseur       Utilisateur? @relation("BonRetourRamasseur", fields: [ramasseurId], references: [id])
  dateAffectation DateTime?    @map("date_affectation")

  // --- Décharge -----------------------------------------------------------
  // Écrit d'un seul coup à la signature. `signatureUrl` porte la signature
  // tracée à l'écran, `photoDechargeUrl` la photo du bon papier signé : les
  // deux sont acceptés (le terrain n'a pas toujours le choix), au moins un
  // des deux est exigé côté API. Même convention de stockage que les preuves
  // de livraison (Commande.signatureUrl / photoPreuveUrl) : une data URL, pas
  // d'infrastructure de stockage objet dans ce projet.
  dateRemise       DateTime? @map("date_remise")
  nomSignataire    String?   @map("nom_signataire")
  signatureUrl     String?   @map("signature_url")
  photoDechargeUrl String?   @map("photo_decharge_url")

  commandes Commande[]

  @@index([marchandId])
  @@index([ramasseurId])
  @@index([hubId])
  @@index([statut])
  @@map("bons_retour")
}

// ============================================================
// Paramètres de la société (§ /admin/parametres)
// ============================================================

// Identité de l'entreprise imprimée sur TOUS les documents sortants : fiche
// de paie livreur, facture marchand, bon de retour, bon de livraison, bon de
// préparation, bon d'envoi. Elle était jusqu'ici écrite en dur dans six
// fichiers — changer un numéro de téléphone imposait six modifications, et
// une seule oubliée suffisait à faire circuler deux versions de l'adresse.
//
// Table à ligne unique (`id` fixé à "societe") plutôt qu'un fichier de
// configuration : ces informations se modifient depuis l'interface, pas par
// un redéploiement.
model ParametresSociete {
  id            String  @id @default("societe")
  raisonSociale String  @default("Mathio Delivery") @map("raison_sociale")
  adresse       String?
  telephone     String?
  email         String?
  siteWeb       String? @map("site_web")
  // Logo en data URL, même convention de stockage que les signatures et les
  // preuves de livraison : ce projet n'a pas d'infrastructure de stockage
  // objet.
  logoUrl       String? @map("logo_url")

  dateMaj DateTime @updatedAt @map("date_maj")

  @@map("parametres_societe")
}

// ============================================================
// Plateformes partenaires — flux ENTRANT (§ intégration Shipeh)
// ============================================================
//
// Une plateforme partenaire est un CANAL DE VENTE : elle nous envoie ses
// marchands et ses colis. C'est l'exact inverse d'un sous-traitant de
// transport (API_PARTENAIRES.md, à qui NOUS confions des colis), et c'est
// pourquoi les deux ne partagent pas de modèle : ils n'ont en commun que le
// mécanisme de clé d'API. Les fusionner donnerait une table dont la moitié
// des colonnes est nulle selon le sens de la relation, et des scopes qui ne
// veulent rien dire d'un côté ou de l'autre.
//
// Tout vit dans ces quatre tables satellites : `commandes`, `marchands` et
// `utilisateurs` ne reçoivent AUCUNE colonne. Abandonner une intégration
// revient donc à supprimer des lignes, jamais à défaire des colonnes sur les
// tables les plus chaudes du schéma.

// Cloisonnement bac à sable / production. Porté par la CLÉ et par le LIEN
// marchand (CompteMarchandExterne), jamais par le colis : un drapeau `estTest`
// sur `commandes` serait une colonne de plus sur la table la plus référencée
// du schéma, et surtout une garantie APPLICATIVE (« ne pas facturer les colis
// de test ») là où la contrainte retenue est STRUCTURELLE — une clé `test` ne
// voit que des marchands `test`, donc ne peut pas créer un colis dans le
// périmètre facturable, quoi que fasse le handler.
enum EnvironnementApi {
  live
  test
}

model PlateformePartenaire {
  id    String  @id @default(uuid())
  // Identifiant stable utilisé dans les journaux et les URL d'administration
  // (ex. "shipeh") — distinct de `nom`, qui est l'étiquette affichée et peut
  // changer sans rien casser.
  code  String  @unique
  nom   String
  actif Boolean @default(true)

  // Compte de service qui SIGNE les écritures faites au nom de la plateforme.
  // Il existe pour une raison précise : HistoriqueStatutCommande.utilisateurId
  // est NON NULLABLE, et un colis ingéré par une machine n'a pas d'auteur
  // humain. Rendre cette colonne nullable aurait touché une table chaude et
  // la vingtaine de lectures qui font `historique.utilisateur.nomComplet` ;
  // un compte porteur du rôle `plateforme` coûte une ligne et rend
  // l'historique honnête (« Shipeh » y apparaît comme auteur).
  //
  // Ce compte ne peut ouvrir de session NULLE PART : le rôle `plateforme`
  // n'appartient à aucun espace (SPACE_ROLES / SPACE_LOGIN_ROLES,
  // lib/auth.ts), donc ni le login ni la vérification de cookie ne peuvent
  // l'accepter — garantie structurelle, indépendante de `actif`.
  utilisateurTechniqueId String      @unique @map("utilisateur_technique_id")
  utilisateurTechnique   Utilisateur @relation("PlateformeUtilisateurTechnique", fields: [utilisateurTechniqueId], references: [id])

  // Transporteur sous-traitant derrière ce compte machine, quand il y en a un.
  //
  // Un compte machine sert désormais DEUX audiences qui n'ont en commun que la
  // mécanique de clés : une plateforme de VENTE (Shipeh) dépose des colis chez
  // nous, un TRANSPORTEUR remonte des statuts sur ceux qu'on lui a confiés.
  // Elles partagent le format de clé, les scopes, le quota et le journal —
  // jamais le périmètre de données.
  //
  // Colonne nullable plutôt qu'un enum `type` à côté : la nature du compte se
  // DÉDUIT du lien (rempli = transporteur, vide = plateforme de vente). Deux
  // sources pour un même fait finissent toujours par diverger, et c'est la
  // divergence qui serait dangereuse ici — un compte marqué « vente » mais lié
  // à un prestataire, ou l'inverse, ouvrirait un périmètre au mauvais tiers.
  //
  // Unique : un prestataire n'a qu'un compte machine. Deux comptes pour le
  // même transporteur voudraient dire deux jeux de clés au même périmètre,
  // donc deux endroits à révoquer le jour d'une fuite — et un oublié.
  //
  // Ce lien ne PORTE pas le périmètre, il le résout seulement. Le périmètre
  // lui-même reste dérivé du référentiel existant : un colis appartient à ce
  // transporteur quand son hub actuel est l'une de ses agences
  // (Commande.hubActuelId → Hub.prestataireId), ce qui est exactement la
  // sémantique du modèle plat Hub↔Ville. Aucune table de remise n'est donc
  // nécessaire pour répondre « ce colis est-il à toi ? ».
  prestataireId String?      @unique @map("prestataire_id")
  prestataire   Prestataire? @relation(fields: [prestataireId], references: [id])

  dateCreation DateTime @default(now()) @map("date_creation")

  cles             CleApiPlateforme[]
  comptesMarchands CompteMarchandExterne[]
  appels           JournalAppelApi[]

  @@map("plateformes_partenaires")
}

// Clé d'API machine. Format : mtk_<env>_<prefixe>_<secret>, cf.
// lib/plateforme-cles.ts pour la composition et le pourquoi de chaque partie.
model CleApiPlateforme {
  id           String               @id @default(uuid())
  plateformeId String               @map("plateforme_id")
  plateforme   PlateformePartenaire @relation(fields: [plateformeId], references: [id], onDelete: Cascade)

  // Partie PUBLIQUE de la clé, indexée et unique : sert au lookup. Sans elle
  // il faudrait comparer le hash de la clé reçue à toutes les lignes de la
  // table à chaque appel.
  prefixe    String @unique
  // SHA-256 du secret, et non bcrypt comme les mots de passe (hashSecret,
  // lib/auth.ts) : le facteur de travail de bcrypt sert à compenser la faible
  // entropie d'un secret CHOISI PAR UN HUMAIN. Un secret de 256 bits tiré de
  // randomBytes n'a pas ce défaut, et 60 à 100 ms de CPU par requête seraient
  // rédhibitoires sur une API appelée en boucle. C'est déjà le raisonnement
  // appliqué aux jetons de réinitialisation et de transfert de session
  // (hashResetToken / hashHandoffToken).
  secretHash String @map("secret_hash")

  environnement EnvironnementApi
  // Périmètre de la clé, en texte libre plutôt qu'en enum Prisma — même
  // raisonnement que Utilisateur.permissions : le catalogue évolue au rythme
  // des endpoints, et les valeurs inconnues sont ignorées à la lecture
  // (assainirScopes, lib/plateforme-cles.ts), donc un scope retiré du
  // catalogue n'accorde plus rien.
  scopes        String[]         @default([])
  libelle       String?

  // Quota par minute et par clé, stocké plutôt que codé en dur : brider une
  // intégration qui s'emballe ne doit pas demander un déploiement.
  quotaParMinute Int @default(600) @map("quota_par_minute")

  creeeLe    DateTime  @default(now()) @map("creee_le")
  // Refus DOUX passé l'échéance (le partenaire est prévenu par un en-tête de
  // dépréciation avant), là où `revoqueeLe` est un refus DUR et immédiat.
  // C'est ce couple qui rend une rotation possible sans coupure : deux clés
  // actives, l'ancienne expirant après que la nouvelle est déployée.
  expireLe   DateTime? @map("expire_le")
  revoqueeLe DateTime? @map("revoquee_le")

  // Jamais supprimée, même révoquée : ces deux compteurs restent exploitables
  // pour une analyse post-incident (quand la clé fuitée a-t-elle servi, et
  // combien de fois).
  derniereUtilisationLe DateTime? @map("derniere_utilisation_le")
  nbAppels              Int       @default(0) @map("nb_appels")

  appels JournalAppelApi[]

  @@index([plateformeId])
  @@map("cles_api_plateforme")
}

// Lien entre un marchand de CHEZ NOUS et son compte CHEZ EUX. Table de liaison
// plutôt qu'une colonne sur `marchands` : un même marchand peut vendre sur
// plusieurs canaux, et le lien porte ses propres attributs (environnement,
// date de synchronisation) qui n'ont pas de sens sur la fiche marchand.
model CompteMarchandExterne {
  id           String               @id @default(uuid())
  plateformeId String               @map("plateforme_id")
  plateforme   PlateformePartenaire @relation(fields: [plateformeId], references: [id], onDelete: Cascade)
  // Identifiant du marchand DANS le système de la plateforme. C'est la clé
  // par laquelle elle nous parle de ce marchand, y compris pour lui rattacher
  // des colis.
  idExterne    String               @map("id_externe")

  marchandId String   @map("marchand_id")
  marchand   Marchand @relation(fields: [marchandId], references: [id], onDelete: Cascade)

  environnement EnvironnementApi

  // La synchronisation a-t-elle CRÉÉ ce marchand, ou seulement rattaché un
  // marchand qui existait déjà chez nous ?
  //
  // Ne sert qu'à une chose, mais elle est décisive : la PURGE des données de
  // test ne supprime que ce que la plateforme a créé. Un marchand rattaché
  // s'était inscrit en direct sur notre site — il ne cesse pas d'être notre
  // client parce qu'une plateforme l'a revendiqué, et l'effacer avec les
  // données de test serait une perte irréversible.
  //
  // Sans cette colonne, la purge reposerait sur une heuristique (le statut, le
  // nombre de liens, l'absence de connexion) ; une heuristique qui se trompe
  // efface un vrai marchand. Défaut `false` : une ligne dont la provenance
  // n'est pas connue n'est JAMAIS supprimée.
  creeParSynchro Boolean @default(false) @map("cree_par_synchro")

  dateCreation DateTime @default(now()) @map("date_creation")
  dateSynchro  DateTime @updatedAt @map("date_synchro")

  // Deux unicités, et il faut les deux : la première rend l'appel de création
  // idempotent (rejouer la même synchronisation ne crée pas un second
  // marchand), la seconde interdit qu'un même marchand soit atteignable sous
  // deux identifiants externes de la même plateforme — sans quoi ses colis se
  // répartiraient entre deux liens selon celui qu'elle envoie.
  //
  // `environnement` fait partie des DEUX clés, et ce n'est pas une précision
  // cosmétique : c'est ce qui rend l'isolation bac à sable / production
  // STRUCTURELLE plutôt que tenue à la main.
  //
  // Prisma dérive de ces contraintes les clés composées
  // `plateformeId_environnement_idExterne` et `..._marchandId`, et un
  // `findUnique` dessus EXIGE les trois champs : chercher un lien en oubliant
  // l'environnement ne compile plus. Sans ça, la garantie reposait sur le fait
  // qu'un développeur pense à comparer les environnements après coup — et
  // l'oubli s'était effectivement produit, sur la recherche « déjà
  // synchronisé » de synchroniserMarchand : une clé `live` y retrouvait le
  // lien de TEST d'un même idExterne, répondait « déjà synchronisé », puis le
  // dépôt de colis échouait en 404. La mise en production était silencieusement
  // cassée pour tout marchand ayant servi aux essais.
  //
  // Conséquence assumée : un même `idExterne` peut exister dans les deux
  // environnements, en deux liens indépendants. C'est le comportement voulu —
  // ce sont deux espaces de noms distincts.
  @@unique([plateformeId, environnement, idExterne])
  @@unique([plateformeId, environnement, marchandId])
  @@index([marchandId])
  @@map("comptes_marchands_externes")
}

// Journal des appels REÇUS. Sa raison d'être est opérationnelle : sans lui,
// diagnostiquer « vos colis ne passent pas » impose de réclamer ses journaux
// au partenaire et de le croire sur parole.
//
// Le corps rejeté n'est VOLONTAIREMENT pas conservé : il porterait des noms,
// téléphones et adresses de clients finaux dans une table de journalisation,
// donc hors du périmètre où ces données sont censées vivre. `erreur` porte le
// message exact du refus (« ville est requis »), qui est ce dont on a besoin
// pour trancher entre un bug chez eux et un bug chez nous.
model JournalAppelApi {
  id           String               @id @default(uuid())
  plateformeId String               @map("plateforme_id")
  plateforme   PlateformePartenaire @relation(fields: [plateformeId], references: [id], onDelete: Cascade)
  // Nullable : un appel refusé pour clé inconnue n'a pas de clé à rattacher.
  cleId        String?              @map("cle_id")
  cle          CleApiPlateforme?    @relation(fields: [cleId], references: [id], onDelete: SetNull)

  methode   String
  chemin    String
  statut    Int
  dureeMs   Int?    @map("duree_ms")
  adresseIp String? @map("adresse_ip")
  // Référence du colis ou du marchand concerné quand l'appel n'en vise qu'un —
  // c'est ce qui rend le journal cherchable sur « où est passé le colis X ».
  reference String?
  erreur    String?

  horodatage DateTime @default(now())

  @@index([plateformeId, horodatage])
  @@index([reference])
  @@map("journal_appels_api")
}
